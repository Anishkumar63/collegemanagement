                    <ul class="contact-list">
                        <li>
                            <i class="fas fa-map-marker-alt"></i>
                            <span>Maa Maturani Devi Pharmacy College Chandadih, Belthara Road, Ballia, Uttar Pradesh, India.</span>
                        </li>
                        <li>
                            <i class="fas fa-phone-alt"></i>
                            <span>+91-6394213627</span>
                        </li>
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>maamaturnidevi@gmail.com</span>
                        </li>
                        <li>
                            <i class="fas fa-clock"></i>
                            <span>Mon-Sat: 9 AM – 3 PM</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Bottom Bar -->
            <div class="footer-bottom">
                <p>&copy; 2026 Maa Maturani Devi Nursing. All Rights Reserved.</p>
            </div>

        </div>
    </footer>

    <!-- Floating Ask AI Button -->
    <a href="#" class="ask-ai-btn">
        <i class="fas fa-sparkles"></i> Ask AI
    </a>

</body>
</html>