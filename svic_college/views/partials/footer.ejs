<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maa Maturani Devi Nursing - Footer</title>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* CSS Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc; /* Just for preview */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        /* =========================================
           FOOTER MAIN STYLES (Exact Screenshot Match)
           ========================================= */
        .footer {
            background-color: #0f172a; /* Dark Navy/Slate color */
            color: #94a3b8;
            padding: 60px 20px 30px;
            width: 100%;
            border-top: 1px solid #1e293b;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Grid Layout */
        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
            gap: 40px;
            margin-bottom: 50px;
        }

        /* Column 1: Brand */
        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            background-color: #0f766e; /* Teal green */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
        }

        .brand-text h3 {
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .brand-text p {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
        }

        .brand-desc {
            font-size: 14px;
            line-height: 1.6;
            color: #94a3b8;
            margin-bottom: 20px;
            padding-right: 20px;
        }

        /* Social Icons */
        .social-links {
            display: flex;
            gap: 10px;
        }

        .social-links a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            background-color: #1e293b;
            color: #cbd5e1;
            border-radius: 50%;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            background-color: #0f766e;
            color: white;
        }

        /* Columns 2, 3, 4: Headings & Links */
        .footer-col h4 {
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 8px;
        }

        .footer-col h4::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 30px;
            height: 2px;
            background-color: #f97316; /* Orange underline */
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: #94a3b8;
            text-decoration: none;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: #ffffff;
        }

        .footer-links a i {
            font-size: 10px;
            color: #f97316; /* Orange chevron */
        }

        /* Contact Column */
        .contact-list {
            list-style: none;
        }

        .contact-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 14px;
            line-height: 1.5;
        }

        .contact-list li i {
            color: #f97316; /* Orange contact icons */
            font-size: 14px;
            margin-top: 3px;
        }

        /* Footer Bottom Bar */
        .footer-bottom {
            border-top: 1px solid #1e293b;
            padding-top: 25px;
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        /* =========================================
           FLOATING ASK AI BUTTON
           ========================================= */
        .ask-ai-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: white;
            padding: 12px 24px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            z-index: 9999;
        }

        .ask-ai-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(14, 165, 233, 0.5);
        }

        .ask-ai-btn i {
            font-size: 16px;
        }

        /* =========================================
           RESPONSIVE DESIGN
           ========================================= */
        @media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 40px;
            }
            .brand-desc {
                padding-right: 0;
            }
        }

        @media (max-width: 768px) {
            .footer {
                padding: 50px 20px 20px;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 30px;
                margin-bottom: 40px;
            }
            .footer-col h4 {
                margin-bottom: 15px;
            }
            .ask-ai-btn {
                bottom: 20px;
                right: 20px;
                padding: 10px 20px;
                font-size: 13px;
            }
        }
    </style>
</head>
<body>

    <!-- ========== FOOTER START ========== -->
    <footer class="footer">
        <div class="footer-container">
            
            <div class="footer-grid">
                
                <!-- Column 1: Brand Information -->
