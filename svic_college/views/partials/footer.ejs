<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>SVIC College | Modern Colorful Interactive Footer</title>
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
* {
    box-sizing: border-box;
}

.footer {
    background: linear-gradient(135deg, #0f172a, #1e1b4b, #2d1b4e);
    color: #e0e7ff;
    width: 100%;
    position: relative;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
}

.footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg,
        #f59e0b, #ec4899, #8b5cf6, #06b6d4, #f59e0b);
    background-size: 200%;
    animation: gradientMove 3s infinite;
}

@keyframes gradientMove {
    0% { background-position: 0%; }
    50% { background-position: 100%; }
    100% { background-position: 0%; }
}

.footer-container {
    max-width: 1280px;
    margin: auto;
    padding: 45px 25px 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 35px;
    margin-bottom: 35px;
}

.footer-col h4 {
    color: #f59e0b;
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 20px;
    position: relative;
    display: inline-block;
}

.footer-col h4::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, #f59e0b, #ec4899);
    border-radius: 3px;
    transition: width .3s;
}

.footer-col:hover h4::after {
    width: 70px;
}

.footer-col p,
.footer-col a {
    color: #cbd5e6;
    font-size: 13px;
    line-height: 1.8;
    text-decoration: none;
    display: block;
    margin-bottom: 10px;
    transition: .3s;
}

.footer-col a:hover {
    color: #f59e0b;
    transform: translateX(6px);
}

.footer-col a i {
    width: 22px;
    color: #f59e0b;
    margin-right: 5px;
}

.social-icons {
    display: flex;
    gap: 12px;
    margin-top: 15px;
}

.social-icons a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(245,158,11,.2);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: .3s;
}

.social-icons a:hover {
    transform: translateY(-5px);
    color: white;
    background: #f59e0b;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
}

.contact-item i {
    color: #f59e0b;
    min-width: 18px;
    margin-top: 4px;
}

.contact-item p {
    margin: 0;
}

.newsletter-section {
    margin-top: 15px;
}

.newsletter-title {
    color: #f59e0b;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 10px;
}

.newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.newsletter-input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid rgba(245,158,11,.3);
    background: rgba(255,255,255,.08);
    border-radius: 50px;
    color: white;
    outline: none;
}

.newsletter-input::placeholder {
    color: #9bb3cc;
}

.newsletter-btn {
    width: fit-content;
    border: none;
    padding: 10px 18px;
    border-radius: 50px;
    color: white;
    background: linear-gradient(135deg, #f59e0b, #ec4899);
    cursor: pointer;
    font-weight: 600;
    transition: .3s;
}

.newsletter-btn:hover {
    transform: translateY(-2px);
}

.footer-bottom {
    border-top: 1px solid rgba(245,158,11,.2);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 11px;
}

.copyright {
    display: flex;
    align-items: center;
    gap: 6px;
}

.copyright i {
    color: #f59e0b;
}

.footer-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.footer-links a {
    color: #9bb3cc;
    text-decoration: none;
    transition: .3s;
}

.footer-links a:hover {
    color: #f59e0b;
}

.back-to-top {
    position: fixed;
    bottom: 25px;
    right: 25px;
    background: linear-gradient(135deg, #f59e0b, #ec4899);
    color: white;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: .3s;
    z-index: 999;
}

.back-to-top.show {
    opacity: 1;
    visibility: visible;
}

@media (max-width: 900px) {
    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .footer-bottom {
        flex-direction: column;
        text-align: center;
    }

    .footer-links {
        justify-content: center;
    }
}
</style>
</head>
<body>
  
    <!-- ========== MODERN COLORFUL INTERACTIVE FOOTER ========== -->
    <footer class="footer">
    <div class="footer-container">

        <div class="footer-grid">

            <!-- College Information -->
            <div class="footer-col">
                <h4>Maa Maturani Devi Pharmacy College</h4>

                <p>
                    Preparing future pharmacy professionals through
                    pharmaceutical education, practical learning,
                    healthcare knowledge and professional development.
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>

                    <a href="#" aria-label="Twitter">
                        <i class="fab fa-twitter"></i>
                    </a>

                    <a href="#" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>

                    <a href="#" aria-label="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>

                    <a href="#" aria-label="YouTube">
                        <i class="fab fa-youtube"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>

                <a href="/pharmacy/about">
                    <i class="fas fa-chevron-right"></i>
                    About Pharmacy College
                </a>

                <a href="/pharmacy/admission">
                    <i class="fas fa-chevron-right"></i>
                    Pharmacy Admissions
                </a>

                <a href="/pharmacy/courses">
                    <i class="fas fa-chevron-right"></i>
                    Pharmacy Courses
                </a>

                <a href="/pharmacy/facilities">
                    <i class="fas fa-chevron-right"></i>
                    Laboratories & Facilities
                </a>

                <a href="/pharmacy/career">
                    <i class="fas fa-chevron-right"></i>
                    Career Opportunities
                </a>

                <a href="/pharmacy/campus">
                    <i class="fas fa-chevron-right"></i>
                    Campus Life
                </a>
            </div>

            <!-- Resources -->
            <div class="footer-col">
                <h4>Resources</h4>

                <a href="/pharmacy/student">
                    <i class="fas fa-chevron-right"></i>
                    Student Information
                </a>

                <a href="/pharmacy/faculty">
                    <i class="fas fa-chevron-right"></i>
                    Faculty Information
                </a>

                <a href="/pharmacy/library">
                    <i class="fas fa-chevron-right"></i>
                    Pharmacy Library
                </a>

                <a href="/pharmacy/exams">
                    <i class="fas fa-chevron-right"></i>
                    Examination Updates
                </a>

                <a href="/pharmacy/fees">
                    <i class="fas fa-chevron-right"></i>
                    Course Fee Information
                </a>

                <a href="/pharmacy/scholarships">
                    <i class="fas fa-chevron-right"></i>
                    Scholarship Information
                </a>
            </div>

            <!-- Contact -->
            <div class="footer-col">
                <h4>Contact Us</h4>

                <div class="contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <p>
                        Maa Maturani Devi Pharmacy College,
                        Ballia, Uttar Pradesh
                    </p>
                </div>

                <div class="contact-item">
                    <i class="fas fa-phone-alt"></i>
                    <p>College Contact Number</p>
                </div>

                <div class="contact-item">
                    <i class="fas fa-envelope"></i>
                    <p>College Email Address</p>
                </div>

                <!-- Newsletter -->
                <div class="newsletter-section">

                    <div class="newsletter-title">
                        <i class="fas fa-paper-plane"></i>
                        Admission & College Updates
                    </div>

                    <div class="newsletter-form">

                        <input
                            type="email"
                            class="newsletter-input"
                            placeholder="Your email address"
                            id="newsletterEmail"
                        >

                        <button
                            class="newsletter-btn"
                            onclick="subscribeNewsletter()"
                        >
                            <i class="fas fa-bell"></i>
                            Subscribe
                        </button>

                    </div>
                </div>
            </div>

        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">

            <div class="copyright">
                <i class="fas fa-heart"></i>

                <span>
                    © 2026 Maa Maturani Devi Pharmacy College.
                    All rights reserved.
                </span>
            </div>

            <div class="footer-links">
                <a href="/pharmacy/privacy">Privacy Policy</a>
                <a href="/pharmacy/terms">Terms of Use</a>
                <a href="/pharmacy/cookies">Cookie Policy</a>
                <a href="/pharmacy/contact">Contact & Support</a>
                <a href="/pharmacy/sitemap">Sitemap</a>
            </div>

        </div>
    </div>
</footer>

<!-- Back to Top Button -->
<div
    class="back-to-top"
    id="backToTop"
    onclick="scrollToTop()"
>
    <i class="fas fa-arrow-up"></i>
</div>
    
    <!-- Back to Top Button -->
    <div class="back-to-top" id="backToTop" onclick="scrollToTop()">
        <i class="fas fa-arrow-up"></i>
    </div>

 <script>
    // Newsletter Subscription
    function subscribeNewsletter() {
        const emailInput = document.getElementById('newsletterEmail');
        const email = emailInput.value.trim();

        if (email === '') {
            showToast('Please enter your email address!', '#f59e0b');
            return;
        }

        if (!email.includes('@') || !email.includes('.')) {
            showToast('Please enter a valid email address!', '#ec4899');
            return;
        }

        showToast('Subscribed successfully! Thank you.', '#10b981');
        emailInput.value = '';
    }

    // Toast Notification
    function showToast(message, color) {
        const toast = document.createElement('div');

        toast.innerHTML = `
            <div style="
                position: fixed;
                bottom: 30px;
                left: 50%;
                transform: translateX(-50%);
                background: ${color};
                color: white;
                padding: 12px 24px;
                border-radius: 50px;
                font-size: 14px;
                z-index: 10000;
                box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            ">
                ${message}
            </div>
        `;

        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Back To Top
    function scrollToTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }

    // Show/Hide Back To Top Button
    window.addEventListener('scroll', () => {
        const button = document.getElementById('backToTop');

        if (window.scrollY > 300) {
            button.classList.add('show');
        } else {
            button.classList.remove('show');
        }
    });

    // Social Media Click
    document.querySelectorAll('.social-icons a').forEach(link => {
        link.addEventListener('click', function(e) {
            if (this.getAttribute('href') === '#') {
                e.preventDefault();

                const platform = this.getAttribute('aria-label');

                showToast(
                    platform + ' link will be added soon!',
                    '#f59e0b'
                );
            }
        });
    });

    // Footer Links
    document.querySelectorAll('.footer-col a').forEach(link => {
        link.addEventListener('click', function(e) {
            if (this.getAttribute('href') === '#') {
                e.preventDefault();

                showToast(
                    'Page Coming Soon!',
                    '#8b5cf6'
                );
            }
        });
    });

    console.log('Pharmacy College Footer Loaded Successfully!');
</script>
</body>
</html>