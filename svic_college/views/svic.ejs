<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">

    <title>Maa Maturani Devi Pharmacy College</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- Swiper CSS -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Existing CSS and JS -->
    <link rel="stylesheet" href="/svic_college/css/slid.css">
    <script src="/svic_college/js/slide.js" defer></script>
    <script src="/svic_college/js/secation.js" defer></script>
    <link rel="stylesheet" href="/svic_college/css/secation.css">

</head>

<body>

    <%- include('partials/header') %>

    <!-- ========== HERO SLIDER ========== -->

    <section style="padding:0;">

        <div class="swiper hero-slider">

            <div class="swiper-wrapper">

                <!-- Slide 1 -->
                <div class="swiper-slide"
                    style="background-image: url('https://images.pexels.com/photos/3683107/pexels-photo-3683107.jpeg?auto=compress&cs=tinysrgb&w=1600');">

                    <div class="slide-content">

                        <h2>Welcome to Maa Maturani Devi Pharmacy College</h2>

                        <p>
                            Building Future Pharmacists Through Quality Education
                            and Practical Learning
                        </p>

                        <button class="btn-hero"
                            onclick="openRegisterModal()">

                            <i class="fas fa-prescription-bottle-alt"></i>
                            Apply Now

                        </button>

                    </div>
                </div>


                <!-- Slide 2 -->
                <div class="swiper-slide"
                    style="background-image: url('https://images.pexels.com/photos/356040/pexels-photo-356040.jpeg?auto=compress&cs=tinysrgb&w=1600');">

                    <div class="slide-content">

                        <h2>Modern Pharmacy Laboratory</h2>

                        <p>
                            Practical Knowledge, Laboratory Training
                            and Professional Skills
                        </p>

                        <button class="btn-hero"
                            onclick="document.getElementById('facilities').scrollIntoView({behavior:'smooth'})">

                            <i class="fas fa-flask"></i>
                            Explore Facilities

                        </button>

                    </div>
                </div>


                <!-- Slide 3 -->
                <div class="swiper-slide"
                    style="background-image: url('https://images.pexels.com/photos/4031867/pexels-photo-4031867.jpeg?auto=compress&cs=tinysrgb&w=1600');">

                    <div class="slide-content">

                        <h2>Start Your Career in Pharmacy</h2>

                        <p>
                            Learn About Medicines, Healthcare,
                            Pharmaceutical Sciences and Research
                        </p>

                        <button class="btn-hero"
                            onclick="document.getElementById('courses').scrollIntoView({behavior:'smooth'})">

                            <i class="fas fa-graduation-cap"></i>
                            Explore Courses

                        </button>

                    </div>
                </div>


                <!-- Slide 4 -->
                <div class="swiper-slide"
                    style="background-image: url('https://images.pexels.com/photos/8460157/pexels-photo-8460157.jpeg?auto=compress&cs=tinysrgb&w=1600');">

                    <div class="slide-content">

                        <h2>Education for a Better Healthcare Future</h2>

                        <p>
                            Develop Knowledge, Skills and Professional
                            Responsibility in Pharmacy
                        </p>

                        <button class="btn-hero"
                            onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">

                            <i class="fas fa-phone"></i>
                            Contact Us

                        </button>

                    </div>
                </div>

            </div>

            <!-- Pagination -->
            <div class="swiper-pagination"></div>

            <!-- Navigation -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>

        </div>

    </section>


    <!-- ========== PHARMACY COURSES ========== -->

    <section class="classes-section" id="courses">

        <div class="container">

            <h2 class="section-title">Our Pharmacy Courses</h2>

            <div class="classes-grid">

                <!-- D.Pharm -->
                <div class="class-card">

                    <div class="class-number">D.Pharm</div>

                    <h3>Diploma in Pharmacy</h3>

                    <p>
                        A pharmacy diploma program focused on pharmaceutical
                        knowledge, medicines, dispensing, practical training
                        and healthcare fundamentals.
                    </p>

                    <button class="btn-primary"
                        style="padding:10px 25px;font-size:0.9rem;"
                        onclick="showNotice('For D.Pharm course details, please contact the college.')">

                        View Details
                        <i class="fas fa-arrow-right"></i>

                    </button>

                </div>


                <!-- B.Pharm -->
                <div class="class-card">

                    <div class="class-number">B.Pharm</div>

                    <h3>Bachelor of Pharmacy</h3>

                    <p>
                        A bachelor's degree program covering pharmaceutical
                        sciences, drug development, laboratory practices,
                        pharmacology and healthcare.
                    </p>

                    <button class="btn-primary"
                        style="padding:10px 25px;font-size:0.9rem;"
                        onclick="showNotice('For B.Pharm course details, please contact the college.')">

                        View Details
                        <i class="fas fa-arrow-right"></i>

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== PHARMACY DEPARTMENTS ========== -->

    <section class="subjects-section" id="departments">

        <div class="container">

            <h2 class="section-title">Pharmacy Education</h2>

            <div class="subjects-grid">

                <!-- Pharmacology -->
                <div class="subject-card">

                    <i class="fas fa-capsules"
                       style="color:#f59e0b;"></i>

                    <h3>Pharmacology</h3>

                    <p>
                        Study of medicines, their effects,
                        therapeutic uses and safety.
                    </p>

                </div>


                <!-- Pharmaceutical Chemistry -->
                <div class="subject-card">

                    <i class="fas fa-flask"
                       style="color:#ec4899;"></i>

                    <h3>Pharmaceutical Chemistry</h3>

                    <p>
                        Understanding chemical properties,
                        composition and analysis of medicines.
                    </p>

                </div>


                <!-- Pharmaceutics -->
                <div class="subject-card">

                    <i class="fas fa-prescription-bottle-alt"
                       style="color:#06b6d4;"></i>

                    <h3>Pharmaceutics</h3>

                    <p>
                        Study of formulation, preparation
                        and delivery of pharmaceutical products.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== FACILITIES SECTION ========== -->

    <section class="classes-section" id="facilities">

        <div class="container">

            <h2 class="section-title">Our Facilities</h2>

            <div class="classes-grid">

                <div class="class-card">

                    <div class="class-number">
                        <i class="fas fa-microscope"></i>
                    </div>

                    <h3>Laboratory</h3>

                    <p>
                        Practical learning and laboratory-based
                        pharmaceutical education.
                    </p>

                </div>


                <div class="class-card">

                    <div class="class-number">
                        <i class="fas fa-book"></i>
                    </div>

                    <h3>Library</h3>

                    <p>
                        Academic books and learning resources
                        for pharmacy students.
                    </p>

                </div>


                <div class="class-card">

                    <div class="class-number">
                        <i class="fas fa-user-graduate"></i>
                    </div>

                    <h3>Academic Learning</h3>

                    <p>
                        Classroom learning, academic guidance
                        and professional development.
                    </p>

                </div>


                <div class="class-card">

                    <div class="class-number">
                        <i class="fas fa-hospital"></i>
                    </div>

                    <h3>Healthcare Knowledge</h3>

                    <p>
                        Learning about medicines, healthcare
                        and pharmaceutical practices.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== NOTICE BOARD ========== -->

    <section class="notice-section" id="notice">

        <div class="container">

            <h2 class="section-title">Notice Board</h2>

            <div class="notice-grid">


                <!-- Latest Notices -->
                <div class="notice-card">

                    <h3>
                        <i class="fas fa-bullhorn"
                           style="color:#f59e0b;"></i>

                        Latest Notices
                    </h3>

                    <ul class="notice-list">

                        <li onclick="showNotice('Please contact the college office for admission information.')">

                            <i class="fas fa-bell"></i>
                            Admission Information

                        </li>

                        <li onclick="showNotice('Contact the college for examination related updates.')">

                            <i class="fas fa-calendar"></i>
                            Examination Updates

                        </li>

                        <li onclick="showNotice('Please contact the college office for academic notices.')">

                            <i class="fas fa-book"></i>
                            Academic Notices

                        </li>

                        <li onclick="showNotice('Contact the college for student related information.')">

                            <i class="fas fa-users"></i>
                            Student Updates

                        </li>

                    </ul>

                </div>


                <!-- Events -->
                <div class="notice-card">

                    <h3>
                        <i class="fas fa-calendar-alt"
                           style="color:#10b981;"></i>

                        Events & Activities
                    </h3>

                    <ul class="notice-list">

                        <li onclick="showNotice('College seminar information will be announced by the college.')">

                            <i class="fas fa-chalkboard-teacher"></i>
                            Educational Seminars

                        </li>

                        <li onclick="showNotice('Laboratory activities and practical schedules are available from the college.')">

                            <i class="fas fa-flask"></i>
                            Practical Activities

                        </li>

                        <li onclick="showNotice('Contact the college for workshop information.')">

                            <i class="fas fa-users"></i>
                            Workshops

                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== ADMISSION SECTION ========== -->

    <section class="subjects-section" id="admission">

        <div class="container">

            <h2 class="section-title">Pharmacy Admission</h2>

            <div style="text-align:center;max-width:700px;margin:0 auto;">

                <p style="margin-bottom:30px;font-size:1.1rem;color:#2c3e50;">

                    Interested in pursuing a career in Pharmacy?
                    Contact our college for course information,
                    eligibility, admission process and required documents.

                </p>

                <button class="btn-primary"
                    onclick="openRegisterModal()"
                    style="padding:14px 40px;font-size:1rem;">

                    <i class="fas fa-file-alt"></i>
                    Apply Online

                </button>

            </div>

        </div>

    </section>


    <!-- ========== CONTACT SECTION ========== -->

    <section class="contact-section" id="contact">

        <div class="container">

            <h2 class="section-title">Contact Us</h2>

            <div class="contact-grid">


                <!-- Contact Information -->
                <div class="contact-info-card">

                    <h3>
                        <i class="fas fa-address-card"></i>
                        College Information
                    </h3>

                    <p>
                        <i class="fas fa-map-marker-alt"></i>
                        Maa Maturani Devi Pharmacy College
                    </p>

                    <p>
                        <i class="fas fa-phone-alt"></i>
                        Contact College Office
                    </p>

                    <p>
                        <i class="fas fa-envelope"></i>
                        College Email
                    </p>

                    <p>
                        <i class="fas fa-clock"></i>
                        College Office Hours
                    </p>

                    <div class="social-icons"
                        style="margin-top:25px;justify-content:flex-start;">

                        <a href="#">
                            <i class="fab fa-facebook-f"></i>
                        </a>

                        <a href="#">
                            <i class="fab fa-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="fab fa-youtube"></i>
                        </a>

                        <a href="#">
                            <i class="fab fa-whatsapp"></i>
                        </a>

                    </div>

                </div>


                <!-- Contact Form -->
                <div class="contact-form-card">

                    <h3 style="margin-bottom:20px;">
                        Send us a Message
                    </h3>

                    <input type="text"
                        placeholder="Your Name"
                        id="msgName">

                    <input type="email"
                        placeholder="Your Email"
                        id="msgEmail">

                    <input type="tel"
                        placeholder="Phone Number"
                        id="msgPhone">

                    <textarea rows="4"
                        placeholder="Your Message"
                        id="msgText"></textarea>

                    <button class="btn-primary"
                        style="width:100%;"
                        onclick="sendMessage()">

                        <i class="fas fa-paper-plane"></i>
                        Send Message

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- ========== ADMISSION MODAL ========== -->

    <div id="registerModal" class="modal-overlay">

        <div class="register-modal">

            <h3>
                <i class="fas fa-graduation-cap"></i>
                Pharmacy Admission Form
            </h3>

            <input type="text"
                id="regName"
                placeholder="Full Name *">

            <input type="text"
                id="regClass"
                placeholder="Course (D.Pharm / B.Pharm) *">

            <input type="email"
                id="regEmail"
                placeholder="Email Address">

            <input type="tel"
                id="regPhone"
                placeholder="Mobile Number *">

            <button class="btn-primary"
                onclick="submitRegistration()">

                <i class="fas fa-check-circle"></i>
                Submit Application

            </button>

            <button class="btn-primary close-modal-btn"
                onclick="closeRegisterModal()">

                <i class="fas fa-times"></i>
                Cancel

            </button>

        </div>

    </div>


    <!-- Toast Message -->
    <div id="toastMsg" class="toast-msg">
        Notice
    </div>


    <!-- Footer -->
    <%- include('partials/footer') %>

</body>
</html>