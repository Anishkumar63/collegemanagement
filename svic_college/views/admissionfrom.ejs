<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>Maa Maturani Devi Pharmacy College | Admission Application</title>
      <link rel="icon" type="image/png" href="images/image copy 6.png">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Admission CSS -->
    <link rel="stylesheet" href="/svic_college/css/admission.css">
</head>

<body>

    <%- include('partials/header') %>

    <!-- Background Particles -->
    <div class="bg-particles" id="particles"></div>

    <section class="admission-section" id="admission">

        <div class="admission-container">

            <div class="admission-form">

                <div id="formMessage" class="alert-message"></div>

                <form id="admissionForm"
                      method="POST"
                      enctype="multipart/form-data">

                    <!-- ================= STUDENT INFORMATION ================= -->

                    <div class="section-title">
                        <i class="fas fa-user-graduate"></i>
                        Applicant Information
                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-studentName">
                            <label>
                                <i class="fas fa-user"></i>
                                Applicant Full Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   name="student_name"
                                   id="student_name"
                                   required
                                   placeholder="Enter applicant full name">
                        </div>

                        <div class="form-group" id="group-dob">
                            <label>
                                <i class="fas fa-calendar-alt"></i>
                                Date of Birth
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   name="dob"
                                   id="dob"
                                   required>
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-gender">
                            <label>
                                <i class="fas fa-venus-mars"></i>
                                Gender
                                <span class="required">*</span>
                            </label>

                            <select name="gender" id="gender" required>
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group" id="group-category">
                            <label>
                                <i class="fas fa-tag"></i>
                                Category
                            </label>

                            <select name="category" id="category">
                                <option value="">-- Select Category --</option>
                                <option value="General">General</option>
                                <option value="OBC">OBC</option>
                                <option value="SC">SC</option>
                                <option value="ST">ST</option>
                                <option value="EWS">EWS</option>
                            </select>
                        </div>

                    </div>

                    <!-- ================= COURSE SELECTION ================= -->

                    <div class="class-group" id="group-course">

                        <label>
                            <i class="fas fa-pills"></i>
                            Select Pharmacy Course
                            <span class="required">*</span>
                        </label>

                        <div class="class-options">

                            <div class="class-option">
                                <input type="radio"
                                       name="course"
                                       id="dpharm"
                                       value="D.Pharm"
                                       required>

                                <label for="dpharm">
                                    D.Pharm
                                </label>
                            </div>

                            <div class="class-option">
                                <input type="radio"
                                       name="course"
                                       id="bpharm"
                                       value="B.Pharm">

                                <label for="bpharm">
                                    B.Pharm
                                </label>
                            </div>

                        </div>

                        <small>
                            Select the pharmacy course for which you are applying.
                        </small>

                    </div>

                    <!-- ================= QUALIFICATION ================= -->

                    <div class="section-title">
                        <i class="fas fa-graduation-cap"></i>
                        Educational Qualification
                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-qualification">
                            <label>
                                <i class="fas fa-book"></i>
                                Qualification
                                <span class="required">*</span>
                            </label>

                            <select name="qualification"
                                    id="qualification"
                                    required>

                                <option value="">-- Select Qualification --</option>
                                <option value="10th">10th Passed</option>
                                <option value="12th">12th Passed</option>
                                <option value="Other">Other</option>

                            </select>
                        </div>

                        <div class="form-group" id="group-subject">
                            <label>
                                <i class="fas fa-flask"></i>
                                Subject / Stream
                            </label>

                            <select name="subject" id="subject">

                                <option value="">-- Select Subjects --</option>
                                <option value="PCB">Physics, Chemistry, Biology (PCB)</option>
                                <option value="PCM">Physics, Chemistry, Mathematics (PCM)</option>
                                <option value="PCMB">Physics, Chemistry, Maths & Biology (PCMB)</option>
                                <option value="Other">Other</option>

                            </select>
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-previousSchool">
                            <label>
                                <i class="fas fa-school"></i>
                                Previous School / College
                            </label>

                            <input type="text"
                                   name="previous_school"
                                   id="previous_school"
                                   placeholder="Enter previous school or college name">
                        </div>

                        <div class="form-group" id="group-board">
                            <label>
                                <i class="fas fa-building"></i>
                                Board / University
                            </label>

                            <select name="board" id="board">

                                <option value="">-- Select Board --</option>
                                <option value="CBSE">CBSE</option>
                                <option value="ICSE">ICSE</option>
                                <option value="UP Board">UP Board</option>
                                <option value="Other State Board">Other State Board</option>
                                <option value="Other">Other</option>

                            </select>
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-percentage">
                            <label>
                                <i class="fas fa-chart-line"></i>
                                Last Examination Percentage (%)
                            </label>

                            <input type="number"
                                   name="percentage"
                                   id="percentage"
                                   step="0.01"
                                   min="0"
                                   max="100"
                                   placeholder="e.g. 75.50">
                        </div>

                        <div class="form-group" id="group-passingYear">
                            <label>
                                <i class="fas fa-calendar-check"></i>
                                Passing Year
                            </label>

                            <input type="number"
                                   name="passing_year"
                                   id="passing_year"
                                   min="2000"
                                   max="2099"
                                   placeholder="e.g. 2026">
                        </div>

                    </div>

                    <!-- ================= PARENT INFORMATION ================= -->

                    <div class="section-title">
                        <i class="fas fa-users"></i>
                        Parent / Guardian Information
                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-fatherName">
                            <label>
                                <i class="fas fa-user"></i>
                                Father's Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   name="father_name"
                                   id="father_name"
                                   required
                                   placeholder="Enter father's full name">
                        </div>

                        <div class="form-group" id="group-motherName">
                            <label>
                                <i class="fas fa-user"></i>
                                Mother's Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   name="mother_name"
                                   id="mother_name"
                                   required
                                   placeholder="Enter mother's full name">
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-parentMobile">
                            <label>
                                <i class="fas fa-phone-alt"></i>
                                Parent / Guardian Mobile
                                <span class="required">*</span>
                            </label>

                            <input type="tel"
                                   name="parent_mobile"
                                   id="parent_mobile"
                                   pattern="[0-9]{10}"
                                   maxlength="10"
                                   required
                                   placeholder="10 digit mobile number">
                        </div>

                        <div class="form-group" id="group-parentEmail">
                            <label>
                                <i class="fas fa-envelope"></i>
                                Email Address
                            </label>

                            <input type="email"
                                   name="parent_email"
                                   id="parent_email"
                                   placeholder="example@gmail.com">
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group" id="group-occupation">
                            <label>
                                <i class="fas fa-briefcase"></i>
                                Father's / Guardian Occupation
                            </label>

                            <input type="text"
                                   name="occupation"
                                   id="occupation"
                                   placeholder="Occupation">
                        </div>

                        <div class="form-group" id="group-annualIncome">
                            <label>
                                <i class="fas fa-rupee-sign"></i>
                                Annual Family Income
                            </label>

                            <select name="annual_income" id="annual_income">

                                <option value="">-- Select Income Range --</option>
                                <option value="Below 2 Lakhs">Below 2 Lakhs</option>
                                <option value="2-5 Lakhs">2-5 Lakhs</option>
                                <option value="5-10 Lakhs">5-10 Lakhs</option>
                                <option value="Above 10 Lakhs">Above 10 Lakhs</option>

                            </select>
                        </div>

                    </div>

                    <!-- ================= ADDRESS ================= -->

                    <div class="section-title">
                        <i class="fas fa-map-marker-alt"></i>
                        Residential Address
                    </div>

                    <div class="form-group" id="group-address">

                        <label>
                            Complete Address
                            <span class="required">*</span>
                        </label>

                        <textarea name="address"
                                  id="address"
                                  rows="3"
                                  maxlength="300"
                                  required
                                  placeholder="Village, post, district, state and PIN code"></textarea>

                        <div class="char-counter" id="addressCounter">
                            0/300 characters
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                <i class="fas fa-city"></i>
                                City / Village
                            </label>

                            <input type="text"
                                   name="city"
                                   id="city"
                                   placeholder="City or village">
                        </div>

                        <div class="form-group">
                            <label>
                                <i class="fas fa-map"></i>
                                District
                            </label>

                            <input type="text"
                                   name="district"
                                   id="district"
                                   placeholder="District">
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                <i class="fas fa-map-pin"></i>
                                PIN Code
                            </label>

                            <input type="text"
                                   name="pincode"
                                   id="pincode"
                                   maxlength="6"
                                   pattern="[0-9]{6}"
                                   placeholder="6 digit PIN code">
                        </div>

                        <div class="form-group">
                            <label>
                                <i class="fas fa-flag"></i>
                                State
                            </label>

                            <input type="text"
                                   name="state"
                                   id="state"
                                   value="Uttar Pradesh"
                                   placeholder="State">
                        </div>

                    </div>

                    <!-- ================= DOCUMENTS ================= -->

                    <div class="section-title">
                        <i class="fas fa-folder-open"></i>
                        Required Documents
                    </div>

                    <small>
                        Upload documents in the permitted format.
                        Maximum file size: 2MB each.
                    </small>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                <i class="fas fa-file-pdf"></i>
                                10th Marksheet
                            </label>

                            <input type="file"
                                   name="marksheet_10"
                                   id="marksheet_10"
                                   accept=".pdf">

                            <small>PDF format (Max 2MB)</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <i class="fas fa-file-pdf"></i>
                                12th Marksheet
                            </label>

                            <input type="file"
                                   name="marksheet_12"
                                   id="marksheet_12"
                                   accept=".pdf">

                            <small>PDF format (Max 2MB)</small>
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                <i class="fas fa-id-card"></i>
                                Aadhaar / Identity Document
                            </label>

                            <input type="file"
                                   name="identity_document"
                                   id="identity_document"
                                   accept=".pdf,.jpg,.jpeg,.png">

                            <small>PDF, JPG or PNG (Max 2MB)</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <i class="fas fa-certificate"></i>
                                Category Certificate
                            </label>

                            <input type="file"
                                   name="category_certificate"
                                   id="category_certificate"
                                   accept=".pdf,.jpg,.jpeg,.png">

                            <small>Optional (Max 2MB)</small>
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                <i class="fas fa-passport"></i>
                                Applicant Photo
                            </label>

                            <input type="file"
                                   name="student_photo"
                                   id="student_photo"
                                   accept="image/jpeg,image/png">

                            <small>Passport size JPG/PNG (Max 2MB)</small>
                        </div>

                        <div class="form-group">
                            <label>
                                <i class="fas fa-file-alt"></i>
                                Migration / Transfer Certificate
                            </label>

                            <input type="file"
                                   name="migration_certificate"
                                   id="migration_certificate"
                                   accept=".pdf">

                            <small>PDF format (Optional, Max 2MB)</small>
                        </div>

                    </div>

                    <!-- ================= DECLARATION ================= -->

                    <div class="form-group declaration-group">

                        <label>
                            <input type="checkbox"
                                   name="declaration"
                                   id="declaration"
                                   value="yes"
                                   required>

                            I declare that the information provided above
                            is true and correct to the best of my knowledge.
                            I agree to follow the rules and regulations of
                            Maa Maturani Devi Pharmacy College.
                            <span class="required">*</span>
                        </label>

                    </div>

                    <!-- ================= SUBMIT ================= -->

                    <button type="submit"
                            class="submit-btn"
                            id="submitBtn">

                        <i class="fas fa-paper-plane"></i>
                        Submit Pharmacy Admission Application

                        <i class="fas fa-arrow-right"></i>

                    </button>

                </form>

            </div>

        </div>

    </section>

    <!-- Admission JavaScript -->
    <script src="/js/admission.js"></script>

    <%- include('partials/footer') %>

</body>
</html>