<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>Pharmacy Admission Procedure | Maa Maturani Devi Pharmacy College</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fef9f0, #fff4e8);
            overflow-x: hidden;
        }

        /* PAGE HEADER */
        .page-header {
            background: linear-gradient(135deg, #1e1b4b, #2d1b4e, #4c1d95);
            padding: 65px 20px;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle,
                rgba(245,158,11,0.12) 0%,
                transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .page-header h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            position: relative;
        }

        .page-header p {
            font-size: 1rem;
            max-width: 750px;
            margin: auto;
            opacity: .9;
            position: relative;
        }

        .container {
            max-width: 1280px;
            margin: auto;
            padding: 60px 20px;
        }

        /* SECTION TITLES */
        .section-title {
            text-align: center;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 35px;
            background: linear-gradient(135deg, #f59e0b, #ec4899);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
        }

        /* ADMISSION STEPS */
        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 60px;
        }

        .step-card {
            background: white;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            transition: .4s;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            position: relative;
            overflow: hidden;
        }

        .step-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,.15);
        }

        .step-number {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #f59e0b, #ec4899);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 28px;
            font-weight: 800;
            color: white;
        }

        .step-icon {
            font-size: 45px;
            color: #f59e0b;
            margin-bottom: 15px;
        }

        .step-card h3 {
            font-size: 1.25rem;
            margin-bottom: 12px;
            color: #1f2937;
        }

        .step-card p {
            color: #6b7280;
            font-size: .9rem;
            line-height: 1.7;
        }

        /* COURSE INFORMATION */
        .course-section {
            background: white;
            padding: 40px;
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,.05);
            margin-bottom: 60px;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .course-card {
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            padding: 30px;
            border-radius: 22px;
            text-align: center;
            border: 1px solid #fde68a;
            transition: .3s;
        }

        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0,0,0,.08);
        }

        .course-card i {
            font-size: 45px;
            color: #f59e0b;
            margin-bottom: 15px;
        }

        .course-card h3 {
            color: #1f2937;
            margin-bottom: 12px;
        }

        .course-card p {
            color: #6b7280;
            font-size: .9rem;
            line-height: 1.7;
        }

        /* IMPORTANT INFORMATION */
        .dates-section {
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            border-radius: 30px;
            padding: 40px;
            margin-bottom: 60px;
        }

        .dates-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
        }

        .date-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            border-left: 4px solid #f59e0b;
            transition: .3s;
        }

        .date-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,.1);
        }

        .date-card i {
            font-size: 35px;
            color: #f59e0b;
            margin-bottom: 12px;
        }

        .date-card h4 {
            margin-bottom: 8px;
            color: #1f2937;
        }

        .date-card .date {
            color: #ec4899;
            font-weight: 600;
            font-size: .95rem;
        }

        /* DOCUMENTS */
        .docs-section {
            background: white;
            border-radius: 30px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,.05);
            margin-bottom: 60px;
        }

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .doc-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 18px;
            background: #f9fafb;
            border-radius: 15px;
            transition: .3s;
        }

        .doc-item:hover {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            transform: translateX(5px);
        }

        .doc-item i {
            font-size: 23px;
            color: #f59e0b;
        }

        .doc-item span {
            font-size: .85rem;
            font-weight: 500;
            color: #374151;
        }

        /* CTA */
        .cta-section {
            background: linear-gradient(135deg, #1e1b4b, #2d1b4e);
            border-radius: 30px;
            padding: 50px;
            text-align: center;
            color: white;
            margin-bottom: 60px;
        }

        .cta-section h2 {
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .cta-section p {
            margin-bottom: 25px;
            opacity: .9;
        }

        .cta-btn {
            background: linear-gradient(135deg, #f59e0b, #ec4899);
            border: none;
            padding: 14px 35px;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            cursor: pointer;
            transition: .3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .cta-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(245,158,11,.4);
        }

        /* FAQ */
        .faq-section {
            margin-bottom: 60px;
        }

        .faq-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .faq-item {
            background: white;
            border-radius: 20px;
            padding: 22px;
            cursor: pointer;
            transition: .3s;
            border: 1px solid #fef3c7;
        }

        .faq-item:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .faq-question {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            color: #1f2937;
        }

        .faq-question i {
            color: #f59e0b;
            transition: transform .3s;
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
            color: #6b7280;
            font-size: .85rem;
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            max-height: 300px;
            margin-top: 12px;
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 1.8rem;
            }

            .section-title {
                font-size: 1.5rem;
            }

            .container {
                padding: 40px 15px;
            }

            .course-section,
            .docs-section,
            .dates-section {
                padding: 25px 18px;
            }

            .cta-section {
                padding: 30px 20px;
            }

            .cta-section h2 {
                font-size: 1.4rem;
            }
        }
    </style>
</head>

<body>

<%- include('partials/header') %>

<!-- PHARMACY ADMISSION HEADER -->
<section class="page-header">
    <h1>
        <i class="fas fa-pills"></i>
        Pharmacy Admission Procedure
    </h1>

    <p>
        Begin your journey towards a career in pharmaceutical sciences,
        healthcare, medicine and patient care at Maa Maturani Devi Pharmacy College.
    </p>
</section>

<div class="container">

    <!-- ADMISSION STEPS -->
    <section class="steps-section">

        <h2 class="section-title">
            <i class="fas fa-list-check"></i>
            Admission Process
        </h2>

        <div class="steps-grid">

            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h3>Admission Enquiry</h3>
                <p>
                    Contact the college or visit the campus to get
                    information about available pharmacy courses,
                    eligibility and admission requirements.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <h3>Application Form</h3>
                <p>
                    Fill out the pharmacy admission application form
                    with your personal details, educational information
                    and preferred course.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h3>Document Submission</h3>
                <p>
                    Submit the required educational certificates,
                    marksheets, photographs and other admission documents
                    for verification.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">4</div>
                <div class="step-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <h3>Eligibility Verification</h3>
                <p>
                    The college verifies the applicant's educational
                    qualification and eligibility according to the
                    applicable admission requirements.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">5</div>
                <div class="step-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h3>Admission Confirmation</h3>
                <p>
                    After document verification and completion of the
                    admission process, the college communicates the
                    admission status to the applicant.
                </p>
            </div>

            <div class="step-card">
                <div class="step-number">6</div>
                <div class="step-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h3>Enrollment</h3>
                <p>
                    Complete the required admission formalities and
                    enrollment process to begin your pharmacy education.
                </p>
            </div>

        </div>
    </section>

    <!-- PHARMACY COURSES -->
    <section class="course-section">

        <h2 class="section-title">
            <i class="fas fa-book-medical"></i>
            Pharmacy Courses
        </h2>

        <div class="course-grid">

            <div class="course-card">
                <i class="fas fa-capsules"></i>

                <h3>Diploma in Pharmacy (D.Pharm)</h3>

                <p>
                    A pharmacy diploma program focused on pharmaceutical
                    fundamentals, dispensing, medicines, pharmacy practice
                    and healthcare knowledge.
                </p>
            </div>

            <div class="course-card">
                <i class="fas fa-microscope"></i>

                <h3>Bachelor of Pharmacy (B.Pharm)</h3>

                <p>
                    An undergraduate pharmacy program covering pharmaceutical
                    sciences, drug formulation, laboratory studies,
                    pharmacology and pharmaceutical practice.
                </p>
            </div>

        </div>
    </section>

    <!-- IMPORTANT DATES -->
    <section class="dates-section">

        <h2 class="section-title">
            <i class="fas fa-calendar-alt"></i>
            Important Admission Information
        </h2>

        <div class="dates-grid">

            <div class="date-card">
                <i class="fas fa-calendar-plus"></i>
                <h4>Admission Start Date</h4>
                <div class="date">Contact College</div>
            </div>

            <div class="date-card">
                <i class="fas fa-calendar-times"></i>
                <h4>Last Date to Apply</h4>
                <div class="date">Contact College</div>
            </div>

            <div class="date-card">
                <i class="fas fa-clipboard-list"></i>
                <h4>Admission Selection</h4>
                <div class="date">As per College Notification</div>
            </div>

            <div class="date-card">
                <i class="fas fa-graduation-cap"></i>
                <h4>Academic Session</h4>
                <div class="date">As per Academic Schedule</div>
            </div>

        </div>
    </section>

    <!-- DOCUMENTS -->
    <section class="docs-section">

        <h2 class="section-title">
            <i class="fas fa-file-circle-check"></i>
            Documents Required
        </h2>

        <div class="docs-grid">

            <div class="doc-item">
                <i class="fas fa-id-card"></i>
                <span>10th Marksheet & Certificate</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-graduation-cap"></i>
                <span>12th Marksheet & Certificate</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-user"></i>
                <span>Passport Size Photographs</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-address-card"></i>
                <span>Identity Proof</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-map-marker-alt"></i>
                <span>Address Proof</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-certificate"></i>
                <span>Category Certificate (if applicable)</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-file-medical"></i>
                <span>Medical Certificate (if required)</span>
            </div>

            <div class="doc-item">
                <i class="fas fa-file-alt"></i>
                <span>Transfer / Migration Certificate (if required)</span>
            </div>

        </div>

    </section>

    <!-- FAQ -->
    <section class="faq-section">

        <h2 class="section-title">
            <i class="fas fa-circle-question"></i>
            Frequently Asked Questions
        </h2>

        <div class="faq-grid">

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>Which pharmacy courses are available?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    The courses listed on this page are D.Pharm and B.Pharm.
                    Please contact the college to confirm current availability
                    and admission status.
                </div>
            </div>

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>What qualification is required for Pharmacy?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    Pharmacy admission generally requires 10+2 with relevant
                    science subjects. Exact subject requirements, minimum
                    marks and eligibility conditions depend on the course
                    and applicable admission rules. Contact the college
                    for confirmation.
                </div>
            </div>

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>How can I apply for admission?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    You can apply using the online admission form available
                    on the college website or contact the college admission
                    office for application assistance.
                </div>
            </div>

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>Which documents are required?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    Documents may include 10th and 12th marksheets,
                    certificates, photographs, identity proof, address proof
                    and other documents required by the college.
                </div>
            </div>

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>Is scholarship available?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    Students may be eligible for scholarships under applicable
                    government or institutional schemes. Scholarship eligibility,
                    availability and application procedures should be confirmed
                    with the college or relevant scholarship authority.
                </div>
            </div>

            <div class="faq-item" onclick="toggleFAQ(this)">
                <div class="faq-question">
                    <span>How can I know the admission fee?</span>
                    <i class="fas fa-chevron-down"></i>
                </div>

                <div class="faq-answer">
                    Contact the college admission office for the latest course
                    fee, registration charges, other fees and payment details.
                </div>
            </div>

        </div>

    </section>

    <!-- CALL TO ACTION -->
    <section class="cta-section">

        <h2>
            <i class="fas fa-capsules"></i>
            Start Your Pharmacy Career
        </h2>

        <p>
            Take the first step towards a future in pharmaceutical education,
            healthcare and pharmacy practice.
        </p>

        <a href="/svic_college/admission"
           class="cta-btn">

            <i class="fas fa-file-signature"></i>
            Apply for Admission

        </a>

    </section>

</div>

<script>
    // FAQ Toggle
    function toggleFAQ(element) {
        element.classList.toggle('active');
    }

    // Toast Notification
    function showToast(message) {
        const toast = document.createElement('div');

        toast.innerHTML = `
            <div style="
                position:fixed;
                bottom:30px;
                left:50%;
                transform:translateX(-50%);
                background:#1e1b4b;
                color:white;
                padding:12px 25px;
                border-radius:50px;
                font-size:14px;
                z-index:10000;
                box-shadow:0 5px 20px rgba(0,0,0,.2);
            ">
                ${message}
            </div>
        `;

        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 2500);
    }

    console.log(
        "Pharmacy Admission Procedure Page Loaded Successfully!"
    );
</script>

<%- include('partials/footer') %>

</body>
</html>