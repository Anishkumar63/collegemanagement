<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Contact Us | Maa Maturani Devi Pharmacy College</title>
    <link rel="icon" type="image/png" href="images/image copy 6.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
/* ===========================
   GLOBAL VARIABLES (merged – one :root only)
=========================== */
:root {
    --primary:       #075e54;
    --primary-dark:  #115e59;
    --secondary:     #0e9482;
    --accent:        #f0a42c;
    --dark:          #18332e;
    --light:         #f4f9f7;
    --white:         #ffffff;
    --text:          #555555;
    --text-dark:     #134e4a;
    --border:        #e2e8f0;

    --shadow-md: 0 8px 28px rgba(15, 118, 110, .16);

    --nav-h:    88px;
    --radius:   10px;
    --t:        .25s ease;
    --t-drawer: .3s cubic-bezier(.4, 0, .2, 1);
}

*, *::before, *::after { box-sizing: border-box; }

html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: #f7faf9;
    color: var(--text);
    line-height: 1.5;
    overflow-x: hidden;
}

body.nav-open { overflow: hidden; }

a    { text-decoration: none; color: inherit; }
ul   { list-style: none; margin: 0; padding: 0; }
img  { max-width: 100%; display: block; }

:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 6px;
}

/* page container */
.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

/* navbar / top-bar container (separate so it never clashes) */
.nav-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ============================================================
   TOP BAR
   ============================================================ */
.top-bar {
    background: var(--primary-dark);
    color: #d1faf5;
    font-size: 13px;
    font-weight: 500;
}

.top-bar-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 16px;
    min-height: 40px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.contact-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 22px;
}

.contact-info span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
}

.contact-info i { color: var(--accent); font-size: 13px; }

.social-icons {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
}

.social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .12);
    color: #fff;
    font-size: 12px;
    transition: background var(--t), transform var(--t);
}

.social-icons a:hover {
    background: var(--accent);
    transform: translateY(-2px);
}

/* ============================================================
   NAVBAR
   ============================================================ */
#navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--t);
}

#navbar.scrolled { box-shadow: var(--shadow-md); }

.nav-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: var(--nav-h);
    padding-top: 10px;
    padding-bottom: 10px;
}

/* ---------- Logo ---------- */
.logo { display: flex; align-items: center; flex-shrink: 0; }
.logo a { display: flex; align-items: center; gap: 12px; }

.school-logo {
    height: 72px;
    width: auto;
    max-width: 280px;
    object-fit: contain;
    transition: height var(--t), max-width var(--t);
}

.logo-fallback {
    display: none;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 800;
    color: var(--primary-dark);
    white-space: nowrap;
}

.logo-fallback i { color: var(--primary); font-size: 26px; }

/* ---------- Desktop nav links ---------- */
.nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
}

.nav-links > li { position: relative; }

.nav-links > li > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-dark);
    white-space: nowrap;
    transition: color var(--t), background var(--t);
}

.nav-links > li > a i {
    font-size: 14px;
    color: var(--primary);
    transition: color var(--t);
}

.nav-links > li > a:hover,
.nav-links > li > a.current {
    background: #ecfdf5;
    color: var(--primary-dark);
}

.nav-links > li > a:hover i { color: var(--primary-dark); }

/* Apply Now (last item = CTA) */
.nav-links > li:last-child > a {
    padding: 12px 24px;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
    box-shadow: 0 4px 12px rgba(7, 94, 84, .28);
}

.nav-links > li:last-child > a i { color: #fff; }

.nav-links > li:last-child > a:hover {
    background: var(--primary-dark);
    color: #fff;
}

/* ---------- Dropdown ---------- */
.dropdown-toggle .fa-chevron-down {
    font-size: 10px !important;
    margin-left: 2px;
    transition: transform var(--t);
}

.dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    min-width: 245px;
    padding: 8px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--t), transform var(--t), visibility var(--t);
    z-index: 60;
}

/* invisible bridge so the menu doesn't close when the mouse moves down */
.dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
}

.dropdown-menu li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #334155;
    transition: background var(--t), color var(--t), transform var(--t);
}

.dropdown-menu li a i {
    width: 20px;
    text-align: center;
    font-size: 13px;
    color: var(--primary);
}

.dropdown-menu li a:hover {
    background: #f0fdfa;
    color: var(--primary-dark);
    transform: translateX(3px);
}

.dropdown.active-drop > .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown.active-drop > .dropdown-toggle .fa-chevron-down {
    transform: rotate(180deg);
}

@media (min-width: 981px) and (hover: hover) {
    .dropdown:hover > .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .dropdown:hover > .dropdown-toggle .fa-chevron-down {
        transform: rotate(180deg);
    }
}

/* ---------- Menu icon & close btn (mobile only) ---------- */
.menu-icon,
.close-menu-li { display: none; }

/* ---------- Overlay ---------- */
.nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, .55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--t), visibility var(--t);
    z-index: 998;
}

.nav-overlay.active { opacity: 1; visibility: visible; }

/* ============================================================
   TABLET & MOBILE (<= 980px)
   ============================================================ */
@media (max-width: 980px) {

    .menu-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin-left: auto;
        padding: 0;
        border: 1px solid #99f6e4;
        border-radius: 10px;
        background: #f0fdfa;
        color: var(--primary-dark);
        font-size: 20px;
        cursor: pointer;
        transition: background var(--t), transform var(--t);
    }

    .menu-icon:active { transform: scale(.95); }

    .nav-links {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(320px, 86vw);
        margin: 0;
        padding: 84px 16px calc(32px + env(safe-area-inset-bottom, 0px));
        flex-direction: column;
        align-items: stretch;
        gap: 2px;
        background: var(--white);
        box-shadow: -10px 0 34px rgba(0, 0, 0, .16);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        transform: translateX(105%);
        visibility: hidden;
        transition: transform var(--t-drawer), visibility var(--t-drawer);
        z-index: 999;
    }

    .nav-links.active {
        transform: translateX(0);
        visibility: visible;
    }

    .close-menu-li {
        display: block;
        width: 100%;
        height: 0;
    }

    .close-menu-btn {
        position: absolute;
        top: 18px;
        right: 16px;
        display: inline-flex;
        width: 42px;
        height: 42px;
        padding: 0;
        border: none;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        color: #334155;
        font-size: 18px;
        cursor: pointer;
        transition: background var(--t), color var(--t);
    }

    .close-menu-btn:hover { background: #fee2e2; color: #dc2626; }

    .nav-links > li { width: 100%; }

    .nav-links > li > a {
        width: 100%;
        justify-content: flex-start;
        padding: 14px;
        font-size: 15px;
        border-radius: 10px;
    }

    .nav-links > li > a i:first-child {
        width: 22px;
        text-align: center;
    }

    .dropdown-toggle .fa-chevron-down { margin-left: auto; }

    .nav-links > li:last-child { margin-top: 10px; }

    .nav-links > li:last-child > a {
        justify-content: center;
        padding: 15px 20px;
        box-shadow: none;
    }

    .dropdown-menu {
        position: static;
        opacity: 1;
        visibility: visible;
        transform: none;
        min-width: 0;
        max-height: 0;
        margin: 0;
        padding: 0;
        border: none;
        border-left: 3px solid #99f6e4;
        border-radius: 0;
        background: #f8fafc;
        box-shadow: none;
        overflow: hidden;
        transition: max-height var(--t-drawer), margin var(--t-drawer),
                    padding var(--t-drawer);
    }

    .dropdown-menu::before { display: none; }

    .dropdown.active-drop > .dropdown-menu {
        max-height: 420px;
        margin: 4px 0 8px 12px;
        padding: 6px 0;
    }

    .dropdown-menu li a {
        padding: 11px 14px;
        font-size: 14px;
    }

    .dropdown-menu li a:hover { transform: none; }
}

/* ============================================================
   SMALL DESKTOP TUNING (981px – 1200px)
   ============================================================ */
@media (min-width: 981px) and (max-width: 1200px) {
    .school-logo {
        height: 62px;
        max-width: 230px;
    }

    .nav-links > li > a {
        padding: 10px 12px;
        font-size: 14px;
        gap: 6px;
    }

    .nav-links > li > a i { font-size: 13px; }

    .nav-links > li:last-child > a { padding: 10px 18px; }
}

/* ============================================================
   SMALL MOBILE (<= 480px)
   ============================================================ */
@media (max-width: 480px) {
    .nav-container { padding: 0 14px; }

    .top-bar { font-size: 12px; }

    .contact-info { gap: 6px 14px; }
    .contact-info span:first-child { display: none; }

    .social-icons a { width: 26px; height: 26px; font-size: 11px; }

    .school-logo {
        height: 58px;
        max-width: 200px;
    }
    .logo-fallback { font-size: 15px; }
    .logo-fallback i { font-size: 21px; }

    .menu-icon { width: 44px; height: 44px; font-size: 18px; }

    .nav-links { padding-top: 78px; }
}

@media (max-width: 360px) {
    .school-logo {
        height: 50px;
        max-width: 165px;
    }
}

/* ===========================
   PAGE HERO
=========================== */
.page-hero {
    position: relative;
    background:
        linear-gradient(135deg, rgba(4,72,64,.95), rgba(10,130,112,.85)),
        url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1600&q=80');
    background-size: cover;
    background-position: center;
    padding: 75px 0;
    text-align: center;
    color: #fff;
}

.page-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    margin: 0 0 12px;
}

.page-hero p {
    font-size: 15px;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
}

.breadcrumb {
    margin-top: 18px;
    font-size: 13px;
}

.breadcrumb a {
    color: #ffd276;
}

/* ===========================
   CONTACT SECTION
=========================== */
.contact-section {
    padding: 70px 0;
}

.section-heading {
    text-align: center;
    margin-bottom: 45px;
}

.section-heading h2 {
    color: var(--primary);
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    margin: 0 0 12px;
}

.section-heading p {
    max-width: 650px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.8;
}

.section-heading .line {
    width: 65px;
    height: 4px;
    background: var(--accent);
    margin: 15px auto;
    border-radius: 5px;
}

/* CONTACT CARDS */
.contact-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-bottom: 55px;
}

.contact-card {
    background: #fff;
    padding: 30px 22px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 5px 25px rgba(0,0,0,.06);
    transition: .3s;
    border-bottom: 3px solid transparent;
    min-width: 0;
}

.contact-card:hover {
    transform: translateY(-7px);
    border-bottom-color: var(--accent);
}

.contact-icon {
    width: 65px;
    height: 65px;
    background: #e8f6f2;
    color: var(--primary);
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 18px;
    border-radius: 50%;
    font-size: 25px;
}

.contact-card h3 {
    color: var(--dark);
    font-size: 18px;
    margin: 0 0 12px;
}

.contact-card p {
    font-size: 13px;
    line-height: 1.8;
    margin: 0;
    word-break: break-word;
}

.contact-card a {
    color: var(--secondary);
    font-weight: 500;
}

/* CONTACT FORM AND MAP */
.contact-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    align-items: stretch;
}

.contact-form-box,
.map-box {
    background: #fff;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 5px 25px rgba(0,0,0,.06);
    min-width: 0;
}

.contact-form-box h2,
.map-box h2 {
    color: var(--primary);
    font-size: 23px;
    margin: 0 0 10px;
}

.contact-form-box > p,
.map-box > p {
    font-size: 13px;
    margin: 0 0 25px;
    line-height: 1.8;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    color: #333;
    font-size: 13px;
    font-weight: 500;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    outline: none;
    background: #fff;
    color: #333;
    transition: .3s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--secondary);
    box-shadow: 0 0 0 3px rgba(14,148,130,.1);
}

.form-group textarea {
    resize: vertical;
    min-height: 120px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.submit-btn {
    background: var(--primary);
    color: #fff;
    border: none;
    padding: 14px 25px;
    width: 100%;
    border-radius: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: .3s;
}

.submit-btn:hover {
    background: var(--secondary);
}

.submit-btn i {
    margin-left: 8px;
}

/* MAP */
.map-box iframe {
    width: 100%;
    height: 390px;
    border: 0;
    border-radius: 8px;
}

.map-link {
    display: inline-block;
    margin-top: 15px;
    color: var(--secondary);
    font-size: 13px;
    font-weight: 500;
}

/* DEPARTMENT CONTACTS */
.department-section {
    padding: 0 0 70px;
}

.department-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.department-card {
    background: #fff;
    padding: 22px;
    border-radius: 10px;
    box-shadow: 0 4px 18px rgba(0,0,0,.05);
    display: flex;
    align-items: center;
    gap: 15px;
    transition: .3s;
    min-width: 0;
}

.department-card:hover {
    transform: translateY(-4px);
}

.department-icon {
    min-width: 48px;
    height: 48px;
    background: #e8f6f2;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 20px;
}

.department-card h3 {
    font-size: 15px;
    color: var(--dark);
    margin: 0 0 5px;
}

.department-card p {
    font-size: 12px;
    margin: 0;
}

/* TOAST */
.toast {
    position: fixed;
    left: 50%;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    max-width: calc(100% - 32px);
    background: var(--primary);
    color: #fff;
    padding: 14px 22px;
    border-radius: 50px;
    box-shadow: 0 5px 25px rgba(0,0,0,.2);
    display: none;
    z-index: 10000;
    font-size: 13px;
    text-align: center;
}

.toast i {
    margin-right: 6px;
}

.toast.error {
    background: #dc2626;
}

.toast.show {
    display: block;
    animation: toastIn .3s ease;
}

@keyframes toastIn {
    from { transform: translateX(-50%) translateY(30px); opacity: 0; }
    to   { transform: translateX(-50%) translateY(0);    opacity: 1; }
}

/* =========================================
   FOOTER (same as About page)
========================================= */
.footer {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 60px 20px calc(25px + env(safe-area-inset-bottom, 0px));
    width: 100%;
    border-top: 1px solid #1e293b;
    font-family: 'Poppins', sans-serif;
}

.footer h3,
.footer h4,
.footer p,
.footer ul {
    margin: 0;
    padding: 0;
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 50px;
}

.footer-col {
    min-width: 0;
}

/* Brand */
.brand-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
}

.brand-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    background-color: #0f766e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
}

.brand-text h3 {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.3px;
    line-height: 1.3;
}

.brand-text p {
    font-size: 12px;
    color: #64748b;
    margin-top: 2px;
}

.brand-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #94a3b8;
    margin-bottom: 20px;
    padding-right: 20px;
}

/* Social */
.social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: #1e293b;
    color: #cbd5e1;
    border-radius: 50%;
    font-size: 14px;
    transition: all 0.3s ease;
}

.social-links a:hover {
    background-color: #0f766e;
    color: #fff;
}

/* Headings + links */
.footer-col h4 {
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 8px;
}

.footer-col h4::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 30px;
    height: 2px;
    background-color: #f97316;
}

.footer-links li {
    margin-bottom: 12px;
}

.footer-links a {
    color: #94a3b8;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s ease, transform 0.3s ease;
}

.footer-links a:hover {
    color: #fff;
    transform: translateX(3px);
}

