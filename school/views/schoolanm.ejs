<!-- ==================== SCRIPTS ==================== -->
<script>
    (function () {
        'use strict';

        // Navbar toggle
        const navLinks = document.getElementById('navLinks');
        const overlay = document.getElementById('menuOverlay');
        const navbar = document.getElementById('navbar');
        const menuIcon = document.getElementById('menuIcon');
        const MOBILE_BREAK = 980;

        function closeDropdowns(except) {
            document.querySelectorAll('.dropdown.active-drop').forEach(function (dd) {
                if (dd !== except) {
                    dd.classList.remove('active-drop');
                    const t = dd.querySelector('.dropdown-toggle');
                    if (t) t.setAttribute('aria-expanded', 'false');
                }
            });
        }

        window.toggleMenu = function () {
            if (!navLinks || !overlay) return;
            const isActive = navLinks.classList.toggle('active');
            overlay.classList.toggle('active', isActive);
            document.body.classList.toggle('nav-open', isActive);
            if (menuIcon) menuIcon.setAttribute('aria-expanded', String(isActive));
            if (!isActive) closeDropdowns();
        };

        document.querySelectorAll('.dropdown-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function (e) {
                e.preventDefault();
                const current = this.closest('.dropdown');
                if (!current) return;
                closeDropdowns(current);
                const isOpen = current.classList.toggle('active-drop');
                this.setAttribute('aria-expanded', String(isOpen));
            });
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.dropdown')) closeDropdowns();
        });

        document.querySelectorAll('#navLinks li a:not(.dropdown-toggle)').forEach(function (link) {
            link.addEventListener('click', function () {
                if (window.innerWidth <= MOBILE_BREAK && navLinks.classList.contains('active')) {
                    window.toggleMenu();
                }
            });
        });

        window.addEventListener('resize', function () {
            if (window.innerWidth > MOBILE_BREAK) {
                navLinks.classList.remove('active');
                overlay.classList.remove('active');
                document.body.classList.remove('nav-open');
                if (menuIcon) menuIcon.setAttribute('aria-expanded', 'false');
                closeDropdowns();
            }
        });

        window.addEventListener('scroll', function () {
            if (!navbar) return;
            navbar.classList.toggle('scrolled', window.scrollY > 20);
        }, { passive: true });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                if (navLinks.classList.contains('active')) window.toggleMenu();
                closeDropdowns();
            }
        });

        [menuIcon, document.querySelector('.close-menu-btn')].forEach(function (el) {
            if (!el) return;
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    window.toggleMenu();
                }
            });
        });

        // Footer year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Page-specific smooth scroll
        function scrollToSection(id) {
            const element = document.getElementById(id);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', event => {
                const href = link.getAttribute('href');
                if (href && href.startsWith('#') && href.length > 1) {
                    const target = document.getElementById(href.slice(1));
                    if (target) {
                        event.preventDefault();
                        scrollToSection(target.id);
                    }
                }
            });
        });

        document.getElementById('knowMoreBtn')?.addEventListener('click', () => {
            scrollToSection('curriculum');
        });

        document.getElementById('brochureBtn')?.addEventListener('click', () => {
            alert('ANM brochure abhi available nahi hai. Please college se contact karein.');
        });

        console.log('ANM page loaded successfully.');
    })();
</script>

