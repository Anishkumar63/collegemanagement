<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0f766e">
    <title>ANM - Auxiliary Nursing Midwifery | Maa Maturani Devi Nursing</title>
    <link rel="icon" type="image/png" href="image copy 2.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <style>
        /* ========== GLOBAL RESET & VARIABLES ========== */
        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #14b8a6;
            --accent: #fb923c;
            --accent-dark: #ea580c;
            --white: #ffffff;
            --bg: #f8fafc;
            --text: #134e4a;
            --muted: #64748b;
            --border: #e2e8f0;
            --shadow-sm: 0 2px 8px rgba(15, 118, 110, .08);
            --shadow-md: 0 8px 28px rgba(15, 118, 110, .16);
            --nav-h: 88px;
            --radius: 10px;
            --t: .25s ease;
            --t-drawer: .3s cubic-bezier(.4, 0, .2, 1);
            /* ANM theme – warm rose */
            --anm-primary: #c95348;
            --anm-dark: #8b3c34;
            --anm-light: #ffe6e0;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 100px; }
        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, Segoe UI, sans-serif;
            color: var(--text);
            background: var(--bg);
            line-height: 1.5;
            overflow-x: hidden;
        }
        body.nav-open { overflow: hidden; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; margin: 0; padding: 0; }
        img { max-width: 100%; display: block; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }

        /* ========== NAVBAR (same as provided) ========== */
        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .top-bar {
            background: var(--primary-dark);
            color: #d1faf5;
            font-size: 13px;
            font-weight: 500;
        }
        .top-bar .flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px 16px;
            min-height: 40px;
            padding-top: 6px;
            padding-bottom: 6px;
        }
        .contact-info {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 22px;
        }
        .contact-info span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }
        .contact-info i { color: var(--accent); font-size: 13px; }
        .social-icons {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }
        .social-icons a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .12);
            color: #fff;
            font-size: 12px;
            transition: background var(--t), transform var(--t);
        }
        .social-icons a:hover { background: var(--accent); transform: translateY(-2px); }

        #navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            transition: box-shadow var(--t);
        }
        #navbar.scrolled { box-shadow: var(--shadow-md); }
        .nav-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            min-height: var(--nav-h);
            padding-top: 10px;
            padding-bottom: 10px;
        }
        .logo { display: flex; align-items: center; flex-shrink: 0; }
        .logo a { display: flex; align-items: center; gap: 12px; }
        .school-logo {
            height: 72px;
            width: auto;
            max-width: 280px;
            object-fit: contain;
            transition: height var(--t), max-width var(--t);
        }
        .logo-fallback {
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            color: var(--primary-dark);
            white-space: nowrap;
        }
        .logo-fallback i { color: var(--primary); font-size: 26px; }
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            margin-left: auto;
        }
        .nav-links > li { position: relative; }
        .nav-links > li > a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            transition: color var(--t), background var(--t);
        }
        .nav-links > li > a i { font-size: 14px; color: var(--primary); transition: color var(--t); }
        .nav-links > li > a:hover { background: #ecfdf5; color: var(--primary-dark); }
        .nav-links > li > a:hover i { color: var(--primary-dark); }
        .nav-links > li:last-child > a {
            padding: 12px 24px;
            border-radius: 999px;
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px rgba(15, 118, 110, .28);
        }
        .nav-links > li:last-child > a i { color: #fff; }
        .nav-links > li:last-child > a:hover { background: var(--primary-dark); color: #fff; }
        .dropdown-toggle .fa-chevron-down {
            font-size: 10px !important;
            margin-left: 2px;
            transition: transform var(--t);
        }
        .dropdown-menu {
            position: absolute;
            top: calc(100% + 12px);
            left: 0;
            min-width: 245px;
            padding: 8px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-md);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: opacity var(--t), transform var(--t), visibility var(--t);
            z-index: 60;
        }
        .dropdown-menu li a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            color: #334155;
            transition: background var(--t), color var(--t), transform var(--t);
        }
        .dropdown-menu li a i { width: 20px; text-align: center; font-size: 13px; color: var(--primary); }
        .dropdown-menu li a:hover { background: #f0fdfa; color: var(--primary-dark); transform: translateX(3px); }
        .dropdown.active-drop > .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown.active-drop > .dropdown-toggle .fa-chevron-down { transform: rotate(180deg); }
        @media (min-width: 981px) and (hover: hover) {
            .dropdown:hover > .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
            .dropdown:hover > .dropdown-toggle .fa-chevron-down { transform: rotate(180deg); }
        }
        .menu-icon, .close-menu-btn { display: none; }
        .nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .55);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--t), visibility var(--t);
            z-index: 998;
        }
        .nav-overlay.active { opacity: 1; visibility: visible; }

        /* ========== ANM PAGE SPECIFIC ========== */
        .anm-hero {
            background: linear-gradient(135deg, #fefcf9 0%, #fff5f0 100%);
            padding: 40px 0 60px;
        }
        .anm-hero .hero-content h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 800;
            line-height: 1.2;
            letter-spacing: -0.02em;
            margin-bottom: 20px;
            color: var(--anm-dark);
        }
        .anm-hero .highlight {
            color: var(--anm-primary);
            border-bottom: 3px solid #fbc4b8;
        }
        .anm-hero .hero-badge {
            background: var(--anm-light);
            color: var(--anm-primary);
            padding: 6px 14px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.8rem;
            display: inline-block;
            margin-bottom: 24px;
        }
        .anm-hero .hero-content p {
            font-size: 1.1rem;
            color: #5b4c4a;
            max-width: 600px;
            margin-bottom: 32px;
        }
        .anm-hero .hero-buttons {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
        }
        .btn-primary-anm {
            background: var(--anm-primary);
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 6px 14px rgba(201,83,72,0.2);
            font-family: inherit;
        }
        .btn-primary-anm:hover {
            background: #a53e34;
            transform: translateY(-2px);
        }
        .btn-outline-anm {
            border: 1.5px solid var(--anm-primary);
            background: transparent;
            padding: 12px 32px;
            border-radius: 40px;
            font-weight: 600;
            color: var(--anm-primary);
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            font-size: 1rem;
        }
        .btn-outline-anm:hover {
            background: var(--anm-primary);
            color: white;
        }
        .hero-image-anm {
            background: var(--anm-light);
            border-radius: 48px;
            padding: 30px;
            text-align: center;
            flex: 0.9;
        }
        .hero-image-anm svg {
            width: 100%;
            height: auto;
            max-width: 300px;
            margin: 0 auto;
        }

        .anm-section {
            padding: 0 0 60px;
        }
        .anm-section .section-title {
            text-align: center;
            font-size: clamp(1.65rem, 3.5vw, 2.2rem);
            font-weight: 700;
            margin-bottom: 16px;
            color: var(--anm-dark);
            line-height: 1.3;
        }
        .anm-section .section-sub {
            text-align: center;
            color: #7a615e;
            max-width: 720px;
            margin: 0 auto 48px auto;
            font-size: 1.05rem;
        }

        .info-grid-anm {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
            gap: 32px;
        }
        .info-card-anm {
            background: white;
            padding: 32px 28px;
            border-radius: 32px;
            border: 1px solid #ffe0d4;
            transition: 0.25s;
            box-shadow: 0 6px 14px rgba(0,0,0,0.02);
        }
        .info-card-anm:hover {
            transform: translateY(-5px);
            border-color: #fbc4b8;
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.08);
        }
        .info-icon-anm {
            background: var(--anm-light);
            width: 56px;
            height: 56px;
            border-radius: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 22px;
        }
        .info-card-anm h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .curriculum-anm {
            background: #fffaf7;
            border-radius: 48px;
            padding: clamp(22px, 4vw, 52px);
        }
        .year-grid-anm {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
            gap: 32px;
            margin-top: 20px;
        }
        .year-card-anm {
            background: white;
            border-radius: 28px;
            padding: clamp(20px, 4vw, 28px);
            border: 1px solid #ffe0d4;
        }
        .year-title-anm {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--anm-primary);
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid #ffe0d4;
        }
        .subject-list-anm {
            list-style: none;
        }
        .subject-list-anm li {
            padding: 10px 0;
            border-bottom: 1px dashed #f7e4dc;
            font-size: 0.95rem;
        }

        .elig-box-anm {
            display: flex;
            flex-wrap: wrap;
            gap: clamp(24px, 4vw, 40px);
            background: #ffffff;
            border-radius: 40px;
            padding: clamp(22px, 4vw, 44px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.04);
            border: 1px solid #ffe0d4;
        }
        .elig-col-anm {
            flex: 1 1 280px;
            min-width: 0;
        }
        .elig-col-anm ul {
            list-style: none;
            line-height: 2;
            margin-top: 18px;
        }
        .elig-col-anm li {
            margin-bottom: 10px;
        }

        .career-grid-anm {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
            gap: 28px;
        }
        .career-item-anm {
            background: white;
            border-radius: 28px;
            padding: 28px 20px;
            text-align: center;
            border: 1px solid #ffe0d4;
            transition: 0.2s;
        }
        .career-item-anm:hover {
            transform: translateY(-4px);
            border-color: #fbc4b8;
        }
        .career-icon-anm {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        .college-list-anm {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            justify-content: center;
            margin-top: 24px;
        }
        .college-badge-anm {
            background: var(--anm-light);
            padding: 12px 28px;
            border-radius: 60px;
            font-weight: 600;
            color: #a53e34;
            font-size: 0.9rem;
            max-width: 100%;
            text-align: center;
            overflow-wrap: anywhere;
        }

        .salary-card-anm {
            background: linear-gradient(135deg, var(--anm-dark), var(--anm-primary));
            color: white;
            border-radius: 32px;
            padding: clamp(22px, 4vw, 32px);
            text-align: center;
            margin-top: 40px;
            overflow-wrap: anywhere;
        }
        .salary-card-anm h3 {
            font-size: 1.6rem;
            margin-bottom: 12px;
        }
        .salary-card-anm p {
            font-size: 1.1rem;
        }

        /* ========== FOOTER (same as provided) ========== */
        .custom-footer {
            --bg-dark: #0f172a;
            --text-main: #cbd5e1;
            --text-muted: #94a3b8;
            --accent-orange: #f97316;
            --accent-teal: #0f766e;
            --social-bg: #1e293b;
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', 'Plus Jakarta Sans', system-ui, sans-serif;
            padding: 70px 0 30px;
            position: relative;
            overflow: hidden;
            margin-top: 40px;
        }
        .custom-footer .footer-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        .custom-footer .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
            gap: 40px;
            margin-bottom: 50px;
        }
        .custom-footer .brand-wrap {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }
        .custom-footer .brand-icon {
            width: 50px;
            height: 50px;
            background-color: var(--accent-teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }
        .custom-footer .brand-text h3 {
            margin: 0;
            color: white;
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.3px;
        }
        .custom-footer .brand-text p {
            margin: 3px 0 0;
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .custom-footer .brand-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 24px;
            max-width: 90%;
        }
        .custom-footer .social-links {
            display: flex;
            gap: 10px;
        }
        .custom-footer .social-links a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background-color: var(--social-bg);
            color: white;
            border-radius: 50%;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        .custom-footer .social-links a:hover {
            background-color: var(--accent-teal);
            transform: translateY(-2px);
        }
        .custom-footer h4 {
            color: white;
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0 0 20px;
            position: relative;
            padding-bottom: 10px;
        }
        .custom-footer h4::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 30px;
            height: 2px;
            background-color: var(--accent-orange);
        }
        .custom-footer ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .custom-footer ul li {
            margin-bottom: 12px;
        }
        .custom-footer ul li a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.2s ease;
        }
        .custom-footer ul li a:hover {
            color: white;
        }
        .custom-footer ul li a i.fa-chevron-right {
            font-size: 0.65rem;
            color: var(--accent-orange);
        }
        .custom-footer .contact-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 14px;
        }
        .custom-footer .contact-list li i {
            color: var(--accent-orange);
            font-size: 1rem;
            margin-top: 3px;
        }
        .custom-footer .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 25px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .ask-ai-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: white;
            padding: 12px 24px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(14, 165, 233, 0.4);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            z-index: 9999;
        }
        .ask-ai-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(14, 165, 233, 0.5);
        }
        .ask-ai-btn i {
            font-size: 1.1rem;
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 1024px) {
            .custom-footer .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
            .custom-footer .brand-desc {
                max-width: 100%;
            }
        }
        @media (max-width: 980px) {
            .menu-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 48px;
                height: 48px;
                margin-left: auto;
                border: 1px solid #99f6e4;
                border-radius: 10px;
                background: #f0fdfa;
                color: var(--primary-dark);
                font-size: 20px;
                cursor: pointer;
                transition: background var(--t), transform var(--t);
            }
            .menu-icon:active { transform: scale(.95); }
            .nav-links {
                position: fixed;
                top: 0;
                right: 0;
                bottom: 0;
                width: min(320px, 86vw);
                margin: 0;
                padding: 84px 16px 32px;
                flex-direction: column;
                align-items: stretch;
                gap: 2px;
                background: var(--white);
                box-shadow: -10px 0 34px rgba(0, 0, 0, .16);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
                transform: translateX(105%);
                transition: transform var(--t-drawer);
                z-index: 999;
            }
            .nav-links.active { transform: translateX(0); }
            .close-menu-btn {
                display: inline-flex;
                position: absolute;
                top: 18px;
                right: 16px;
                width: 42px;
                height: 42px;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #f1f5f9;
                color: #334155;
                font-size: 18px;
                cursor: pointer;
                transition: background var(--t), color var(--t);
            }
            .close-menu-btn:hover { background: #fee2e2; color: #dc2626; }
            .nav-links > li { width: 100%; }
            .nav-links > li > a {
                width: 100%;
                justify-content: flex-start;
                padding: 14px 14px;
                font-size: 15px;
                border-radius: 10px;
            }
            .nav-links > li > a i:first-child {
                width: 22px;
                text-align: center;
            }
            .nav-links > li:last-child { margin-top: 10px; }
            .nav-links > li:last-child > a {
                justify-content: center;
                padding: 15px 20px;
                box-shadow: none;
            }
            .dropdown-menu {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                min-width: 0;
                max-height: 0;
                margin: 0;
                padding: 0;
                border: none;
                border-left: 3px solid #99f6e4;
                border-radius: 0;
                background: #f8fafc;
                box-shadow: none;
                overflow: hidden;
                transition: max-height var(--t-drawer), margin var(--t-drawer), padding var(--t-drawer);
            }
            .dropdown.active-drop > .dropdown-menu {
                max-height: 420px;
                margin: 4px 0 8px 12px;
                padding: 6px 0;
            }
            .dropdown-menu li a {
                padding: 11px 14px;
