<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>Maa Maturani Devi Pharmacy College</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/school/css/nav.css">
</head>

<body>

<!-- Top Bar -->
<div class="top-bar">
    <div class="container flex">

        <div class="contact-info">
            <span>
                <i class="fas fa-graduation-cap"></i>
                Maa Maturani Devi Pharmacy College
            </span>

            <span>
                <i class="fas fa-location-dot"></i>
                Ballia, Uttar Pradesh
            </span>
        </div>

        <div class="social-icons">
            <a href="#" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
            </a>

            <a href="#" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>

            <a href="#" aria-label="YouTube">
                <i class="fab fa-youtube"></i>
            </a>
        </div>

    </div>
</div>


<!-- Navbar -->
<nav id="navbar">

    <div class="container nav-flex">

        <!-- Pharmacy Logo -->
        <div class="logo">
            <a href="/pharmacy">
                <img
                    class="school-logo"
                    src="public/image copy.png"
                    alt="Maa Maturani Devi Pharmacy College Logo"
                >
            </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="menu-icon" id="menuIcon" onclick="toggleMenu()">
            <i class="fas fa-bars"></i>
        </div>

        <!-- Navigation Links -->
        <ul class="nav-links" id="navLinks">

            <!-- Close Button -->
            <div class="close-menu-btn" onclick="toggleMenu()">
                <i class="fas fa-times"></i>
            </div>

            <!-- Home -->
            <li>
                <a href="/pharmacy">
                    <i class="fas fa-home"></i>
                    Home
                </a>
            </li>

            <!-- About Dropdown -->
            <li class="dropdown">

                <a href="javascript:void(0)" class="dropdown-toggle">
                    <i class="fas fa-info-circle"></i>
                    About
                    <i class="fas fa-chevron-down"></i>
                </a>

                <ul class="dropdown-menu">

                    <li>
                        <a href="/pharmacy/about">
                            <i class="fas fa-building"></i>
                            About Pharmacy College
                        </a>
                    </li>

                    <li>
                        <a href="/pharmacy/director">
                            <i class="fas fa-user-tie"></i>
                            Director's Desk
                        </a>
                    </li>

                    <li>
                        <a href="/pharmacy/principal">
                            <i class="fas fa-user-graduate"></i>
                            Principal's Desk
                        </a>
                    </li>

                    <li>
                        <a href="/pharmacy/infrastructure">
                            <i class="fas fa-flask"></i>
                            Infrastructure
                        </a>
                    </li>

                </ul>
            </li>

            <!-- Admission -->
            <li>
                <a href="/pharmacy/admission">
                    <i class="fas fa-graduation-cap"></i>
                    Admission
                </a>
            </li>

            <!-- Courses Dropdown -->
            <li class="dropdown">

                <a href="javascript:void(0)" class="dropdown-toggle">
                    <i class="fas fa-book-open"></i>
                    Courses
                    <i class="fas fa-chevron-down"></i>
                </a>

                <ul class="dropdown-menu">

                    <li>
                        <a href="/pharmacy/dpharm">
                            <i class="fas fa-capsules"></i>
                            D.Pharm
                        </a>
                    </li>

                    <li>
                        <a href="/pharmacy/bpharm">
                            <i class="fas fa-prescription-bottle-medical"></i>
                            B.Pharm
                        </a>
                    </li>

                </ul>
            </li>

            <!-- Gallery -->
            <li>
                <a href="/pharmacy/gallery">
                    <i class="fas fa-images"></i>
                    Gallery
                </a>
            </li>

            <!-- Activities -->
            <li>
                <a href="/pharmacy/activities">
                    <i class="fas fa-calendar-check"></i>
                    Activities
                </a>
            </li>

            <!-- Feedback -->
            <li>
                <a href="/pharmacy/feedback">
                    <i class="fas fa-comment-dots"></i>
                    Feedback
                </a>
            </li>

            <!-- Contact -->
            <li>
                <a href="/pharmacy/contact">
                    <i class="fas fa-envelope"></i>
                    Contact
                </a>
            </li>

            <!-- Apply Now -->
            <li>
                <a href="/pharmacy/admission">
                    <i class="fas fa-pen-to-square"></i>
                    Apply Now
                </a>
            </li>

        </ul>

    </div>
</nav>

<!-- Overlay -->
<div id="menuOverlay" class="nav-overlay" onclick="toggleMenu()"></div>


<!-- Navbar JavaScript -->
<script>
(function () {

    const navLinks = document.getElementById('navLinks');
    const overlay = document.getElementById('menuOverlay');
    const navbar = document.getElementById('navbar');

    // Toggle mobile menu
    window.toggleMenu = function () {

        if (!navLinks || !overlay) return;

        const isActive = navLinks.classList.toggle('active');

        overlay.classList.toggle('active');

        document.body.style.overflow = isActive ? 'hidden' : '';

        // Close dropdowns when menu closes
        if (!isActive) {
            document.querySelectorAll('.dropdown.active-drop')
                .forEach(drop => drop.classList.remove('active-drop'));
        }
    };


    // Dropdown functionality
    function setupDropdowns() {

        document.querySelectorAll('.dropdown').forEach(drop => {

            const toggle = drop.querySelector('.dropdown-toggle');

            if (!toggle) return;

            toggle.onclick = function (e) {

                e.preventDefault();

                const isMobile = window.innerWidth <= 980;

                if (isMobile) {

                    document.querySelectorAll('.dropdown.active-drop')
                        .forEach(activeDrop => {
                            if (activeDrop !== drop) {
                                activeDrop.classList.remove('active-drop');
                            }
                        });

                    drop.classList.toggle('active-drop');

                }

            };

        });

    }


    // Close mobile menu after navigation
    document.querySelectorAll('#navLinks li a:not(.dropdown-toggle)')
        .forEach(link => {

            link.addEventListener('click', function () {

                if (window.innerWidth <= 980 &&
                    navLinks.classList.contains('active')) {

                    window.toggleMenu();

                }

            });

        });


    // Resize handling
    window.addEventListener('resize', function () {

        if (window.innerWidth > 980) {

            navLinks.classList.remove('active');
            overlay.classList.remove('active');
            document.body.style.overflow = '';

            document.querySelectorAll('.dropdown.active-drop')
                .forEach(drop => drop.classList.remove('active-drop'));

        }

    });


    // Scroll shadow effect
    window.addEventListener('scroll', function () {

        if (window.scrollY > 20) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }

    });


    // Escape key closes menu
    document.addEventListener('keydown', function (e) {

        if (e.key === 'Escape' &&
            navLinks.classList.contains('active')) {

            window.toggleMenu();

        }

    });


    setupDropdowns();

    console.log("Pharmacy Navbar Loaded Successfully");

})();
</script>

</body>
</html>