<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0f766e">

    <title>Maa Maturani Devi Nursing</title>
      <link rel="icon" type="image/png" href="image copy 2.png">
<!-- school/public/image copy 2.png -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        /* ============================================================
           NURSING NAVBAR — CLEAN & RESPONSIVE (BIGGER SIZE)
           ============================================================ */

        :root {
            --primary:       #0f766e;
            --primary-dark:  #115e59;
            --primary-light: #14b8a6;
            --accent:        #fb923c;
            --accent-dark:   #ea580c;

            --white:  #ffffff;
            --bg:     #f8fafc;
            --text:   #134e4a;
            --muted:  #64748b;
            --border: #e2e8f0;

            --shadow-sm: 0 2px 8px rgba(15, 118, 110, .08);
            --shadow-md: 0 8px 28px rgba(15, 118, 110, .16);

            --nav-h:    88px;                 /* ⬆ bada kiya */
            --radius:   10px;
            --t:        .25s ease;
            --t-drawer: .3s cubic-bezier(.4, 0, .2, 1);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, Segoe UI, sans-serif;
            color: var(--text);
            background: var(--bg);
            line-height: 1.5;
        }

        body.nav-open { overflow: hidden; }

        a   { text-decoration: none; color: inherit; }
        ul  { list-style: none; margin: 0; padding: 0; }
        img { max-width: 100%; display: block; }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
            border-radius: 6px;
        }

        /* ---------- Container ---------- */
        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ============================================================
           TOP BAR
           ============================================================ */
        .top-bar {
            background: var(--primary-dark);
            color: #d1faf5;
            font-size: 13px;
            font-weight: 500;
        }

        .top-bar .flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px 16px;
            min-height: 40px;
            padding-top: 6px;
            padding-bottom: 6px;
        }

        .contact-info {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 22px;
        }

        .contact-info span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .contact-info i { color: var(--accent); font-size: 13px; }

        .social-icons {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .social-icons a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .12);
            color: #fff;
            font-size: 12px;
            transition: background var(--t), transform var(--t);
        }

        .social-icons a:hover {
            background: var(--accent);
            transform: translateY(-2px);
        }

        /* ============================================================
           NAVBAR
           ============================================================ */
        #navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            transition: box-shadow var(--t);
        }

        #navbar.scrolled { box-shadow: var(--shadow-md); }

        .nav-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            min-height: var(--nav-h);
            padding-top: 10px;
            padding-bottom: 10px;
        }

        /* ---------- Logo (BADA) ---------- */
        .logo { display: flex; align-items: center; flex-shrink: 0; }
        .logo a { display: flex; align-items: center; gap: 12px; }

        .school-logo {
            height: 72px;                     /* ⬆ 54 → 72 */
            width: auto;
            max-width: 280px;                 /* ⬆ 220 → 280 */
            object-fit: contain;
            transition: height var(--t), max-width var(--t);
        }

        .logo-fallback {
            display: none;
            align-items: center;
            gap: 10px;
            font-size: 18px;                  /* ⬆ 16 → 18 */
            font-weight: 800;
            color: var(--primary-dark);
            white-space: nowrap;
        }

        .logo-fallback i { color: var(--primary); font-size: 26px; } /* ⬆ 22 → 26 */

        /* ---------- Desktop nav links ---------- */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 2px;
            margin-left: auto;
        }

        .nav-links > li { position: relative; }

        .nav-links > li > a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;               /* ⬆ padding bada */
            border-radius: 8px;
            font-size: 15px;                  /* ⬆ 14 → 15 */
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            transition: color var(--t), background var(--t);
        }

        .nav-links > li > a i {
            font-size: 14px;                  /* ⬆ 13 → 14 */
            color: var(--primary);
            transition: color var(--t);
        }

        .nav-links > li > a:hover {
            background: #ecfdf5;
            color: var(--primary-dark);
        }

        .nav-links > li > a:hover i { color: var(--primary-dark); }

        /* Apply Now (last item = CTA) */
        .nav-links > li:last-child > a {
            padding: 12px 24px;               /* ⬆ CTA bada */
            border-radius: 999px;
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 12px rgba(15, 118, 110, .28);
        }

        .nav-links > li:last-child > a i { color: #fff; }

        .nav-links > li:last-child > a:hover {
            background: var(--primary-dark);
            color: #fff;
        }

        /* ---------- Dropdown ---------- */
        .dropdown-toggle .fa-chevron-down {
            font-size: 10px !important;
            margin-left: 2px;
            transition: transform var(--t);
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 12px);
            left: 0;
            min-width: 245px;                 /* ⬆ thoda bada */
            padding: 8px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-md);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: opacity var(--t), transform var(--t), visibility var(--t);
            z-index: 60;
        }

        .dropdown-menu li a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 14px;               /* ⬆ dropdown item bada */
            border-radius: 8px;
            font-size: 14px;                  /* ⬆ 13.5 → 14 */
            font-weight: 500;
            color: #334155;
            transition: background var(--t), color var(--t), transform var(--t);
        }

        .dropdown-menu li a i {
            width: 20px;
            text-align: center;
            font-size: 13px;
            color: var(--primary);
        }

        .dropdown-menu li a:hover {
            background: #f0fdfa;
            color: var(--primary-dark);
            transform: translateX(3px);
        }

        .dropdown.active-drop > .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown.active-drop > .dropdown-toggle .fa-chevron-down {
            transform: rotate(180deg);
        }

        @media (min-width: 981px) and (hover: hover) {
            .dropdown:hover > .dropdown-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }
            .dropdown:hover > .dropdown-toggle .fa-chevron-down {
                transform: rotate(180deg);
            }
        }

        /* ---------- Menu icon & close btn (mobile only) ---------- */
        .menu-icon,
        .close-menu-btn { display: none; }

        /* ---------- Overlay ---------- */
        .nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .55);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--t), visibility var(--t);
            z-index: 998;
        }

        .nav-overlay.active { opacity: 1; visibility: visible; }

        /* ============================================================
           TABLET & MOBILE (<= 980px)
           ============================================================ */
        @media (max-width: 980px) {

            .menu-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 48px;                  /* ⬆ 44 → 48 */
                height: 48px;
                margin-left: auto;
                border: 1px solid #99f6e4;
                border-radius: 10px;
                background: #f0fdfa;
                color: var(--primary-dark);
                font-size: 20px;              /* ⬆ 18 → 20 */
                cursor: pointer;
                transition: background var(--t), transform var(--t);
            }

            .menu-icon:active { transform: scale(.95); }

            .nav-links {
                position: fixed;
                top: 0;
                right: 0;
                bottom: 0;
                width: min(320px, 86vw);
                margin: 0;
                padding: 84px 16px 32px;      /* ⬆ 72 → 84 */
                flex-direction: column;
                align-items: stretch;
                gap: 2px;
                background: var(--white);
                box-shadow: -10px 0 34px rgba(0, 0, 0, .16);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
                transform: translateX(105%);
                transition: transform var(--t-drawer);
                z-index: 999;
            }

            .nav-links.active { transform: translateX(0); }

            .close-menu-btn {
                display: inline-flex;
                position: absolute;
                top: 18px;
                right: 16px;
                width: 42px;                  /* ⬆ 40 → 42 */
                height: 42px;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #f1f5f9;
                color: #334155;
                font-size: 18px;
                cursor: pointer;
                transition: background var(--t), color var(--t);
            }

            .close-menu-btn:hover { background: #fee2e2; color: #dc2626; }

            .nav-links > li { width: 100%; }

            .nav-links > li > a {
                width: 100%;
                justify-content: flex-start;
                padding: 14px 14px;           /* ⬆ thoda bada */
                font-size: 15px;              /* ⬆ 14.5 → 15 */
                border-radius: 10px;
            }

            .nav-links > li > a i:first-child {
                width: 22px;
                text-align: center;
            }

            .nav-links > li:last-child { margin-top: 10px; }

            .nav-links > li:last-child > a {
                justify-content: center;
                padding: 15px 20px;
                box-shadow: none;
            }

            .dropdown-menu {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                min-width: 0;
                max-height: 0;
                margin: 0;
                padding: 0;
                border: none;
                border-left: 3px solid #99f6e4;
                border-radius: 0;
                background: #f8fafc;
                box-shadow: none;
                overflow: hidden;
                transition: max-height var(--t-drawer), margin var(--t-drawer),
                            padding var(--t-drawer);
            }

            .dropdown.active-drop > .dropdown-menu {
                max-height: 420px;
                margin: 4px 0 8px 12px;
                padding: 6px 0;
            }

            .dropdown-menu li a {
                padding: 11px 14px;
                font-size: 14px;
            }

            .dropdown-menu li a:hover { transform: none; }
        }

        /* ============================================================
           SMALL DESKTOP TUNING (981px – 1200px)
           ============================================================ */
        @media (min-width: 981px) and (max-width: 1200px) {
            .school-logo {
                height: 62px;                 /* ⬆ 48 → 62 */
                max-width: 230px;
            }

            .nav-links > li > a {
                padding: 10px 12px;
                font-size: 14px;              /* ⬆ 13 → 14 */
                gap: 6px;
            }

            .nav-links > li > a i { font-size: 13px; }

            .nav-links > li:last-child > a { padding: 10px 18px; }
        }

        /* ============================================================
           SMALL MOBILE (<= 480px)
           ============================================================ */
        @media (max-width: 480px) {
            .container { padding: 0 14px; }

            .top-bar { font-size: 12px; }

            .contact-info { gap: 6px 14px; }
            .contact-info span:first-child { display: none; }

            .social-icons a { width: 26px; height: 26px; font-size: 11px; }

            .school-logo {
                height: 58px;                 /* ⬆ 46 → 58 */
                max-width: 200px;             /* ⬆ 170 → 200 */
            }
            .logo-fallback { font-size: 15px; }
            .logo-fallback i { font-size: 21px; }

            .menu-icon { width: 44px; height: 44px; font-size: 18px; }

            .nav-links { padding-top: 78px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

<!-- ==================== TOP BAR ==================== -->
<div class="top-bar">
    <div class="container flex">

        <div class="contact-info">
            <span>
                <i class="fas fa-user-nurse"></i>
                Maa Maturani Devi Nursing
            </span>
            <span>
                <i class="fas fa-location-dot"></i>
                Ballia, Uttar Pradesh
            </span>
        </div>

        <div class="social-icons">
            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        </div>

    </div>
</div>


<!-- ==================== NAVBAR ==================== -->
<nav id="navbar">
    <div class="container nav-flex">

        <!-- Logo -->
        <div class="logo">
            <a href="/nursing">
                <img class="school-logo"
                     src="image copy.png"
                     alt="Maa Maturani Devi Nursing Logo"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">
                <span class="logo-fallback">
                    <i class="fas fa-user-nurse"></i>
                    Maa Maturani Devi Nursing
                </span>
            </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="menu-icon"
             id="menuIcon"
             role="button"
             tabindex="0"
             aria-label="Open menu"
             aria-expanded="false"
             aria-controls="navLinks"
             onclick="toggleMenu()">
            <i class="fas fa-bars"></i>
        </div>

        <!-- Navigation Links -->
        <ul class="nav-links" id="navLinks">

            <!-- Close Button (mobile) -->
            <div class="close-menu-btn"
                 role="button"
                 tabindex="0"
                 aria-label="Close menu"
                 onclick="toggleMenu()">
                <i class="fas fa-times"></i>
            </div>

            <!-- Home -->
            <li>
                <a href="/school">
                    <i class="fas fa-home"></i> Home
                </a>
            </li>

            <!-- About Dropdown -->
            <li class="dropdown">
                <a href="javascript:void(0)"
                   class="dropdown-toggle"
                   aria-haspopup="true"
                   aria-expanded="false">
                    <i class="fas fa-info-circle"></i>
                    About
                    <i class="fas fa-chevron-down"></i>
                </a>

                <ul class="dropdown-menu">
                    <li>
                        <a href="/school/nursingabout">
                            <i class="fas fa-hospital"></i> About Nursing
                        </a>
                    </li>
                    <li>
                        <a href="/school/director">
                            <i class="fas fa-user-tie"></i> Director's Desk
                        </a>
                    </li>
                    <li>
                        <a href="/school/principal">
                            <i class="fas fa-user-nurse"></i> Principal's Desk
                        </a>
                    </li>
                    <li>
                        <a href="/school/infrastructure">
                            <i class="fas fa-hospital-user"></i> Infrastructure
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Courses Dropdown -->
            <li class="dropdown">
                <a href="javascript:void(0)"
                   class="dropdown-toggle"
                   aria-haspopup="true"
                   aria-expanded="false">
                    <i class="fas fa-book-medical"></i>
                    Courses
                    <i class="fas fa-chevron-down"></i>
                </a>

                <ul class="dropdown-menu">
                    <li>
                        <a href="/school/anm">
                            <i class="fas fa-user-nurse"></i> ANM
                        </a>
                    </li>
                    <li>
                        <a href="/school/jnam">
                            <i class="fas fa-heart-pulse"></i> JNAM
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Admission -->
            <li>
                <a href="/school/admission">
                    <i class="fas fa-graduation-cap"></i> Admission
                </a>
            </li>

            <!-- Gallery -->
            <li>
                <a href="/school/galleary">
                    <i class="fas fa-images"></i> Gallery
                </a>
            </li>

            <!-- Contact -->
            <li>
                <a href="/school/contact">
                    <i class="fas fa-envelope"></i> Contact
                </a>
            </li>

            <!-- Apply Now (CTA) -->
            <li>
                <a href="/school/admission">
                    <i class="fas fa-pen-to-square"></i> Apply Now
                </a>
            </li>

        </ul>
    </div>
</nav>

<!-- Overlay -->
<div id="menuOverlay" class="nav-overlay" onclick="toggleMenu()"></div>


<!-- ==================== NAVBAR JS ==================== -->
<script>
(function () {
    'use strict';

    const navLinks = document.getElementById('navLinks');
    const overlay  = document.getElementById('menuOverlay');
    const navbar   = document.getElementById('navbar');
    const menuIcon = document.getElementById('menuIcon');

    const MOBILE_BREAK = 980;

    function closeDropdowns(except) {
        document.querySelectorAll('.dropdown.active-drop').forEach(function (dd) {
            if (dd !== except) {
                dd.classList.remove('active-drop');
                const t = dd.querySelector('.dropdown-toggle');
                if (t) t.setAttribute('aria-expanded', 'false');
            }
        });
    }

    window.toggleMenu = function () {
        if (!navLinks || !overlay) return;

        const isActive = navLinks.classList.toggle('active');

        overlay.classList.toggle('active', isActive);
        document.body.classList.toggle('nav-open', isActive);

        if (menuIcon) menuIcon.setAttribute('aria-expanded', String(isActive));

        if (!isActive) closeDropdowns();
    };

    document.querySelectorAll('.dropdown-toggle').forEach(function (toggle) {
        toggle.addEventListener('click', function (e) {
            e.preventDefault();

            const current = this.closest('.dropdown');
            if (!current) return;

            closeDropdowns(current);

            const isOpen = current.classList.toggle('active-drop');
            this.setAttribute('aria-expanded', String(isOpen));
        });
    });

    document.addEventListener('click', function (e) {
        if (!e.target.closest('.dropdown')) closeDropdowns();
    });

    document.querySelectorAll('#navLinks li a:not(.dropdown-toggle)')
        .forEach(function (link) {
            link.addEventListener('click', function () {
                if (window.innerWidth <= MOBILE_BREAK &&
                    navLinks.classList.contains('active')) {
                    window.toggleMenu();
                }
            });
        });

    window.addEventListener('resize', function () {
        if (window.innerWidth > MOBILE_BREAK) {
            navLinks.classList.remove('active');
            overlay.classList.remove('active');
            document.body.classList.remove('nav-open');

            if (menuIcon) menuIcon.setAttribute('aria-expanded', 'false');
            closeDropdowns();
        }
    });

    window.addEventListener('scroll', function () {
        if (!navbar) return;
        navbar.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            if (navLinks.classList.contains('active')) window.toggleMenu();
            closeDropdowns();
        }
    });

    [menuIcon, document.querySelector('.close-menu-btn')].forEach(function (el) {
        if (!el) return;
        el.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                window.toggleMenu();
            }
        });
    });

    console.log('Maa Maturani Devi Nursing Navbar Loaded');
})();
</script>

</body>
</html>