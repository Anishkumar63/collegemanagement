<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0f766e">
    <meta name="description" content="Maa Maturani Devi Nursing, Ballia — ANM & JNAM nursing programs with hospital training, experienced faculty, and girls' hostel facility.">
    <title>Maa Maturani Devi Nursing | Ballia, Uttar Pradesh</title>
      <link rel="icon" type="image/png" href="image copy 2.png">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        /* ============================================================
           NURSING INDEX PAGE — RESPONSIVE
           ============================================================ */
        :root {
            --primary:       #0f766e;
            --primary-dark:  #115e59;
            --primary-soft:  #ccfbf1;
            --accent:        #ea580c;
            --accent-soft:   #fed7aa;
            --ink:           #134e4a;
            --ink-2:         #475569;
            --muted:         #64748b;
            --bg:            #f8fafc;
            --card:          #ffffff;
            --line:          #dbe7e4;
            --shadow-sm:     0 2px 10px rgba(15, 118, 110, .06);
            --shadow-md:     0 10px 34px rgba(15, 118, 110, .14);
            --shadow-lg:     0 18px 48px rgba(15, 118, 110, .18);
            --radius:        16px;
            --container:     1240px;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
            color: var(--ink);
            background: var(--bg);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        img { max-width: 100%; display: block; }
        a { color: inherit; text-decoration: none; }
        ul { list-style: none; margin: 0; padding: 0; }

        .container {
            width: 100%;
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Section base */
        section { padding: 72px 0; position: relative; }
        .sec-head { text-align: center; margin-bottom: 46px; }
        .sec-head .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary-soft);
            color: var(--primary-dark);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }
        .sec-head .eyebrow i { color: var(--accent); }
        .sec-head h2 {
            font-family: 'Playfair Display', 'Plus Jakarta Sans', serif;
            font-size: clamp(1.6rem, 3vw + .4rem, 2.4rem);
            font-weight: 700;
            color: var(--primary-dark);
            margin: 0 0 10px;
            line-height: 1.2;
        }
        .sec-head p {
            max-width: 640px;
            margin: 0 auto;
            color: var(--muted);
            font-size: .95rem;
            line-height: 1.7;
        }
        .sec-head .line {
            width: 64px; height: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent-soft));
            border-radius: 3px;
            margin: 14px auto 0;
        }

        /* ============================================================
           HERO SLIDER
           ============================================================ */
        #home { padding: 0; }

        .hero-slider {
            width: 100%;
            height: clamp(480px, 82vh, 720px);
            position: relative;
            overflow: hidden;
        }

        .swiper-slide {
            position: relative;
            display: flex;
            align-items: center;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: #fff;
            overflow: hidden;
        }

        .swiper-slide::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg,
                rgba(15, 118, 110, 0.88) 0%,
                rgba(17, 94, 89, 0.78) 45%,
                rgba(13, 77, 71, 0.65) 100%);
            z-index: 1;
        }

        .swiper-slide::after {
            content: "\f0f8";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            right: -30px;
            bottom: -50px;
            font-size: 280px;
            line-height: 1;
            color: rgba(255, 255, 255, 0.05);
            z-index: 1;
            pointer-events: none;
        }

        .slide-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
            padding: 40px clamp(20px, 6vw, 80px);
        }

        .slide-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 16px;
            backdrop-filter: blur(4px);
        }

        .slide-eyebrow i { color: var(--accent-soft); }

        .slide-content h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.9rem, 4vw + .5rem, 3.2rem);
            font-weight: 700;
            line-height: 1.15;
            margin: 0 0 14px;
            letter-spacing: .3px;
            text-shadow: 0 3px 18px rgba(0, 0, 0, 0.25);
        }

        .slide-content h2 span { color: var(--accent-soft); display: inline-block; }

        .slide-content p {
            font-size: clamp(.95rem, 1.1vw + .4rem, 1.12rem);
            line-height: 1.65;
            margin: 0 0 26px;
            color: #e6fffb;
            max-width: 560px;
        }

        .slide-actions { display: flex; flex-wrap: wrap; gap: 12px; }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 13px 26px;
            border: none;
            border-radius: 999px;
            font-family: inherit;
            font-size: .95rem;
            font-weight: 700;
            letter-spacing: .2px;
            cursor: pointer;
            transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
        }

        .btn i { font-size: .92rem; }

        .btn-primary {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 8px 24px rgba(234, 88, 12, 0.4);
        }
        .btn-primary:hover {
            background: #c2410c;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(234, 88, 12, 0.5);
        }

        .btn-outline {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.7);
        }
        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: #fff;
            transform: translateY(-2px);
        }

        .btn-teal {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 8px 24px rgba(15, 118, 110, 0.28);
        }
        .btn-teal:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* Swiper controls */
        .swiper-pagination { bottom: 22px !important; }

        .swiper-pagination-bullet {
            width: 10px; height: 10px;
            background: rgba(255, 255, 255, 0.55);
            opacity: 1;
            transition: all .25s ease;
        }
        .swiper-pagination-bullet-active {
            background: var(--accent);
            width: 28px;
            border-radius: 6px;
        }

        .swiper-button-next,
        .swiper-button-prev {
            width: 50px; height: 50px;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            color: #fff !important;
            backdrop-filter: blur(6px);
            transition: background .25s ease, transform .25s ease;
            margin-top: calc(0px - 25px);
        }
        .swiper-button-next:hover,
        .swiper-button-prev:hover {
            background: var(--accent);
            border-color: var(--accent);
            transform: scale(1.06);
        }
        .swiper-button-next::after,
        .swiper-button-prev::after { font-size: 16px !important; font-weight: 800; }

        /* ============================================================
           STATS STRIP
           ============================================================ */
        .stats-strip {
            background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
            padding: 32px 0;
            color: #fff;
            position: relative;
            z-index: 3;
            margin-top: -40px;
            border-radius: 20px;
            max-width: var(--container);
            margin-left: auto;
            margin-right: auto;
            width: calc(100% - 40px);
            box-shadow: var(--shadow-lg);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 0 20px;
        }

        .stat-item {
            text-align: center;
            padding: 6px 10px;
            border-right: 1px solid rgba(255, 255, 255, 0.15);
        }
        .stat-item:last-child { border-right: none; }

        .stat-item .icon {
            color: var(--accent-soft);
            font-size: 1.4rem;
            margin-bottom: 6px;
            display: inline-block;
        }
        .stat-item .num {
            display: block;
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.6rem, 2.5vw + .4rem, 2.2rem);
            font-weight: 700;
            line-height: 1.1;
            color: #fff;
        }
        .stat-item .label {
            display: block;
            font-size: .78rem;
            color: #d8f5f0;
            margin-top: 4px;
            font-weight: 500;
            letter-spacing: .3px;
        }

        /* ============================================================
           ABOUT SECTION
           ============================================================ */
        #about { background: var(--bg); }

        .about-grid {
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-img-wrap {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            aspect-ratio: 4 / 3.4;
        }
        .about-img-wrap img {
            width: 100%; height: 100%;
            object-fit: cover;
        }
        .about-img-wrap::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 60%, rgba(15, 118, 110, 0.4));
            pointer-events: none;
        }

        .about-badge {
            position: absolute;
            bottom: 20px;
            left: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.96);
            color: var(--primary-dark);
            border-radius: 12px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(6px);
            box-shadow: 0 4px 16px rgba(0,0,0,.1);
        }
        .about-badge i {
            color: var(--accent);
            font-size: 1.5rem;
        }
        .about-badge strong { display: block; font-size: .92rem; }
        .about-badge span { font-size: .78rem; color: var(--muted); }

        .about-copy h2 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.5rem, 2.5vw + .4rem, 2.1rem);
            color: var(--primary-dark);
            margin: 0 0 16px;
            line-height: 1.25;
        }
        .about-copy p {
            color: var(--ink-2);
            font-size: .94rem;
            line-height: 1.75;
            margin: 0 0 14px;
        }

        .about-points {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 20px;
            margin: 22px 0 26px;
        }
        .about-points li {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            font-size: .88rem;
            color: var(--ink-2);
        }
        .about-points li i {
            color: var(--primary);
            font-size: .95rem;
            margin-top: 3px;
            flex-shrink: 0;
        }

        /* ============================================================
           COURSES
           ============================================================ */
        #courses { background: #fff; }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 26px;
        }

        .course-card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform .3s ease, box-shadow .3s ease;
            display: flex;
            flex-direction: column;
        }
        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

        .course-top {
            background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
            padding: 24px 22px 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .course-top::after {
            content: "\f0f8";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            right: -10px; bottom: -22px;
            font-size: 100px;
            color: rgba(255, 255, 255, 0.07);
            pointer-events: none;
        }
        .course-tag {
            display: inline-block;
            background: var(--accent);
            color: #fff;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        .course-top h3 {
            margin: 0 0 4px;
            font-size: 1.15rem;
            line-height: 1.3;
            font-weight: 700;
        }
        .course-top .duration {
            font-size: .85rem;
            color: #d8f5f0;
        }

        .course-body { padding: 20px 22px 24px; flex: 1; display: flex; flex-direction: column; }
        .course-body ul { margin: 0 0 16px; flex: 1; }
        .course-body ul li {
            display: flex;
            gap: 8px;
            font-size: .87rem;
            color: var(--ink-2);
            margin-bottom: 8px;
            line-height: 1.5;
        }
        .course-body ul li i {
            color: var(--primary);
            font-size: .8rem;
            margin-top: 3px;
            flex-shrink: 0;
        }
        .seat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary-soft);
            color: var(--primary-dark);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 700;
            margin-bottom: 16px;
            align-self: flex-start;
        }
        .course-body .btn {
            width: 100%;
            padding: 11px 20px;
            font-size: .88rem;
        }

        /* ============================================================
           WHY CHOOSE US
           ============================================================ */
        #why {
            background: linear-gradient(180deg, #f0fdfa 0%, #f8fafc 100%);
        }

        .why-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
        }

        .why-card {
            background: #fff;
            border-radius: 14px;
            padding: 26px 22px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--line);
            transition: transform .3s ease, box-shadow .3s ease, border-color .3s;
            position: relative;
            overflow: hidden;
        }
        .why-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            border-color: var(--primary-soft);
        }

        .why-icon {
            width: 52px; height: 52px;
            background: var(--primary-soft);
            color: var(--primary-dark);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            margin-bottom: 16px;
            transition: background .3s, color .3s;
        }
        .why-card:hover .why-icon {
            background: var(--primary);
            color: #fff;
        }
        .why-card h3 {
            margin: 0 0 8px;
            font-size: 1.02rem;
            color: var(--primary-dark);
            font-weight: 700;
        }
        .why-card p {
            margin: 0;
            font-size: .86rem;
            color: var(--ink-2);
            line-height: 1.6;
        }

        /* ============================================================
           CTA BAND
           ============================================================ */
        #cta { padding: 40px 0 72px; }

        .cta-band {
            border-radius: 22px;
            background:
                radial-gradient(circle at 90% 20%, rgba(251, 146, 60, .3), transparent 55%),
                linear-gradient(135deg, #0f766e 0%, #115e59 60%, #0d4d47 100%);
            color: #fff;
            padding: 48px 32px;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            align-items: center;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }
        .cta-band::after {
            content: "\f0f8";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            position: absolute;
            right: 20px; bottom: -40px;
            font-size: 200px;
            color: rgba(255, 255, 255, 0.06);
            pointer-events: none;
        }
        .cta-band h2 {
            margin: 0 0 8px;
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.4rem, 2.5vw + .4rem, 2rem);
            line-height: 1.2;
        }
        .cta-band p {
            margin: 0;
            color: #d8f5f0;
            font-size: .94rem;
            max-width: 520px;
        }
        .cta-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        footer {
            background: #0f172a;
            color: #cbd5e1;
            padding: 54px 0 24px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
            gap: 36px;
            margin-bottom: 36px;
        }
        .footer-col h4 {
            color: #fff;
            font-size: 1rem;
            margin: 0 0 16px;
            font-weight: 700;
            position: relative;
            padding-bottom: 10px;
        }
        .footer-col h4::after {
            content: "";
            position: absolute;
            left: 0; bottom: 0;
            width: 32px; height: 3px;
            background: var(--accent);
            border-radius: 2px;
        }
        .footer-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }
        .footer-brand .icon {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
        }
        .footer-brand h3 {
            margin: 0;
            color: #fff;
            font-size: 1rem;
            line-height: 1.3;
        }
        .footer-brand small { font-size: .72rem; color: #94a3b8; }
        .footer-col p {
            font-size: .86rem;
            color: #94a3b8;
            line-height: 1.7;
            margin: 0 0 12px;
        }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a {
            font-size: .86rem;
            color: #94a3b8;
            transition: color .2s, padding .2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .footer-links a i { font-size: .68rem; color: var(--accent); }
        .footer-links a:hover { color: var(--accent); padding-left: 3px; }

        .footer-contact li {
            display: flex;
            gap: 10px;
            font-size: .86rem;
            color: #94a3b8;
            margin-bottom: 10px;
            line-height: 1.5;
        }
        .footer-contact li i { color: var(--accent); margin-top: 3px; flex-shrink: 0; }

        .footer-social {
            display: flex;
            gap: 10px;
            margin-top: 16px;
        }
        .footer-social a {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .88rem;
            transition: background .25s, transform .25s;
        }
        .footer-social a:hover { background: var(--accent); transform: translateY(-2px); }

        .footer-bottom {
            border-top: 1px solid #1e293b;
            padding-top: 20px;
            text-align: center;
            font-size: .82rem;
            color: #64748b;
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 1024px) {
            .about-grid { gap: 32px; }
            .cta-band { grid-template-columns: 1fr; text-align: center; }
            .cta-actions { justify-content: center; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
            .hero-slider { height: clamp(440px, 70vh, 620px); }
        }

        @media (max-width: 768px) {
            section { padding: 54px 0; }
            .sec-head { margin-bottom: 32px; }

            .stats-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
            .stat-item {
                border-right: none;
                border-bottom: 1px solid rgba(255, 255, 255, .12);
                padding: 14px 8px;
            }
            .stat-item:nth-child(3),
            .stat-item:nth-child(4) { border-bottom: none; }

            .about-grid { grid-template-columns: 1fr; }
            .about-points { grid-template-columns: 1fr; }
            .about-img-wrap { aspect-ratio: 16 / 10; }

            .hero-slider { height: clamp(440px, 68vh, 560px); }
            .slide-content { max-width: 100%; padding: 30px clamp(18px, 5vw, 36px); }
            .swiper-slide::after { font-size: 160px; right: -14px; bottom: -30px; }

            .swiper-button-next,
            .swiper-button-prev {
                width: 42px; height: 42px;
                margin-top: calc(0px - 21px);
            }
            .swiper-button-next { right: 12px !important; }
            .swiper-button-prev { left: 12px !important; }
            .swiper-pagination { bottom: 14px !important; }

            .cta-band { padding: 34px 22px; }
        }

        @media (max-width: 480px) {
            .container { padding: 0 14px; }
            section { padding: 46px 0; }

            .hero-slider { height: clamp(420px, 65vh, 520px); }
            .slide-actions { flex-direction: column; width: 100%; }
            .btn { width: 100%; padding: 12px 20px; font-size: .88rem; }
            .swiper-slide::after { display: none; }
            .swiper-button-next,
            .swiper-button-prev { display: none; }

            .stats-strip {
                width: calc(100% - 24px);
                margin-top: -28px;
                border-radius: 16px;
                padding: 24px 0;
            }

